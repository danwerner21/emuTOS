  29               	/* array that holds the machine state; see 'debug.h' */
  30               	state:
  31 0000 0000 0000 	s_d:	.ds.l	8	/* 8 data registers */
  31      0000 0000 
  31      0000 0000 
  31      0000 0000 
  31      0000 0000 
  32 0020 0000 0000 	s_a:	.ds.l	7	/* 7 address registers */
  32      0000 0000 
  32      0000 0000 
  32      0000 0000 
  32      0000 0000 
  33 003c 0000 0000 	s_ssp:	.ds.l	1	/* s_a[7] is the SSP (MSP) */
  34 0040 0000 0000 	s_usp:	.ds.l	1	/* the User Stack Pointer, USP */
  35 0044 0000 0000 	s_pc:	.ds.l	1	/* program counter (next instruction) */
  36 0048 0000      	s_frame: .ds.w	1	/* stack frame type (should be zero) */
  37 004a 0000      	s_sr:	.ds.w	1	/* SR -- status register (full) */
  38               	.if CPU>68010
  39               	s_isp:	.ds.l	1	/* ISP for the debugger */
  40               	s_msp:	.ds.l	1	/* MSP explicitly */
  41               	.endif
  42               	
  43               	
  44               	trace_count:		/* was popped to D0 */
  45               	trace_save:
  46 004c 0000 0000 		.ds.l	15	/* 8 data + 7 address registers */
  46      0000 0000 
  46      0000 0000 
  46      0000 0000 
68K GAS  beetle.s 			page 2


  46      0000 0000 
  47 0088 0000 0000 	t_ssp:	.ds.l	1	/* SSP for debugger */
  48               		
  49               	
  50               	TRACE_BIT	=	0x8000	/* T1 bit on 68020 */
  51               	TRACE_MASK	=	0xC000	/* masks T1/T0 bits on 68020 */
  52               	SUPV_BIT	=	0x2000
  53               	IPL_BITS	=	0x0700
  54               	
  55               	X_BIT		=	0b10000
  56               	N_BIT		=	0b01000
  57               	Z_BIT		=	0b00100
  58               	V_BIT		=	0b00010
  59               	C_BIT		=	0b00001
  60               	
  61               		.text
  62               	Trace:
  63 0000 0079 8000 		or.w	#TRACE_BIT,s_sr		/* set Trace (T1) bit */
  63      0000 0000 
  64 0008 21FC 0000 		move.l	#trace_trap,4*9		/* set to receive trap */
  64      0000 0024 
  65               	Go:
  66 0010 21FC 0000 		move.l	#breakpoint_trap,4*4	/* set to receive breakpoint trap */
  66      0000 0010 
  67               	
  68 0018 4EB9 0000 		jsr	install_breaks		/* install all breakpoints */
  68      0000 
  69               	
  70 001e 205F      		move.l	(%sp)+,%a0		/* save return in A0 */
  71 0020 201F      		move.l	(%sp)+,%d0		/* get trace count in D0 */
  72               	 /* the trace_count is in D0, and will be the function return */
  73 0022 48F9 FFFF 		movem.l	%d0-%d7/%a0-%a7,trace_save	/* save all regs */
  73      0000 0000 
  74               	
  75               	dispatch_user:
  76 002a 3039 0000 		move.w	s_frame,%d0		/* see if the frame is valid */
  76      0000 
  77 0030 6B08      		bmi.s	du0
  78               	
  79               	/* frame is valid, restore the stack pointers */
  80               	.if 0 /*CPU>68010*/
  81               		move.l	s_msp,%d1		/* explicit restore of MSP */
  82               		movec	%d1,%msp
  83               		move.l	s_isp,%d1		/* explicit restore of ISP */
  84               		movec	%d1,%isp
  85               	.endif
  86 0032 2E79 0000 		move.l	s_ssp,%sp		/* set SSP */
  86      0000 
  87 0038 6002      		br.s	du1
  88               	du0:
  89 003a 7000      		move.l	#0,%d0			/* frame was not created by trap or breakpoint */
  90               	/* continue the state restore */
  91               	du1:
  92 003c 2279 0000 		move.l	s_usp,%a1		/* set User USP */
  92      0000 
  93 0042 4E61      		move.l	%a1,%usp		/* */
  94               	

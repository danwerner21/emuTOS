  95               	/* create the RTE frame */
  96               	.if CPU>=68010
  97               		move.w	%d0,-(%sp)		/* RTE frame type */
  98               	.endif
  99 0044 2F39 0000 		move.l	s_pc,-(%sp)		/* push User resume PC */
  99      0000 
 100 004a 3F39 0000 		move.w	s_sr,-(%sp)
 100      0000 
 101 0050 4CF9 7FFF 		movem.l	state,%d0-%d7/%a0-%a6	/* restore User register state */
 101      0000 0000 
 102 0058 4E73      		rte		  		/* resume User program */
 103               	
 104               	
 105               	
 106               	trace_trap:
 107 005a 53B9 0000 		sub.l	#1,trace_count		/* count the instruction */
 107      0000 
 108 0060 670C      		beq.s	trace_done
 109 0062 4E73      		rte				/* count not expired */
 110               	
 111               	breakpoint_trap:
 112 0064 13FC 0001 		move.b	#1,break_taken		/* flag breakpoint */
 112      0000 0000 
 113 006c 6006      		bra.s	common_reentry
 114               	
 115               	trace_done:
 116 006e 4239 0000 		clr.b	break_taken		/* flag no breakpoint */
 116      0000 
 117               	common_reentry:
 118 0074 48F9 7FFF 		movem.l	%d0-%d7/%a0-%a6,state	/* save all registers */
 118      0000 0000 
 119 007c 301F      		move.w	(%sp)+,%d0		/* grab the SR */
 120 007e 0240 3FFF 		and.w	#~TRACE_MASK,%d0	/* clear the T1/T0 bits */
 121 0082 33C0 0000 		move.w	%d0,s_sr		/* save the program status */
 121      0000 
 122 0088 23DF 0000 		move.l	(%sp)+,s_pc		/* save the User resume point */
 122      0000 
 123               	.if CPU>=68010
 124               		move.w	(%sp)+,s_frame		/* save interrupt frame word */
 125               	.else
 126 008e 4279 0000 		clr.w	s_frame			/* or mark as valid so SSP is restored */
 126      0000 
 127               	.endif
 128 0094 23CF 0000 		move.l	%sp,s_ssp		/* save user SSP (ISP) */
 128      0000 
 129               	.if CPU>68010
 130               		movec	%isp,%d0		/* save the ISP */
 131               		move.l	%d0,s_isp
 132               		movec	%msp,%d0		/* save the MSP */
 133               		move.l	%d0,s_msp
 134               	.endif
 135 009a 4E69      		move.l	%usp,%a1		/* save USP */
 136 009c 23C9 0000 		move.l	%a1,s_usp
 136      0000 
 137               	
 138 00a2 4CF9 FFFF 		movem.l	trace_save,%d0-%d7/%a0-%a7	/* restore Trace call state */
 138      0000 0000 

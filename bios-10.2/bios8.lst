  22               	#
  23               	#	Handle BIOS traps (vector 8) and dispatch
  24               	#	to the proper Handler (BIOS call implementation)
  25               	#
  26               	#
  27               	# start with some bit definitions:
  28               	#
  29               	ccr_carry	=	0x01		/* carry bit mask */
  30               	ccr_overflow	=	0x02		/* overflow */
  31               	ccr_zero	=	0x04		/* zero bit mask */
  32               	ccr_sign	=	0x08		/* sign bit mask */
  33               	ccr_extend	=	0x10		/* extend bit mask */
  34               	
  35               	sr_super	=	0x2000		/* supervisor mode bit mask */
  36               	sr_trace	=	0x8000		/* trace mode bit mask */
  37               	
  38               	
  39               	#	BIOS dispatch
  40               	
  41               	# 3 entry points:
  42               		.globl	bios_trap_entry
  43               		.globl	bios_good_return
  44               		.globl	bios_error_return
  45               	
  46               	
  47               	Flags	=	ccr_sign + ccr_overflow + ccr_carry
  48               	
  49               	bios_good_return:
  50 0000 2C5F      		move.l	(%sp)+,%a6	/* restore A6 */
  51 0002 0257 FFF4 		and.w	#~Flags,(%sp)	/* clear the Sign, Carry and Overflow */
  52 0006 4E73      		rte			/* return from exception */
  53               	
  54               	
  55               	
  56               	# dispatch to here on any undefine BIOS call numbers
  57               	#
68K GAS  bios8.s 			page 2


  58               	undefined:
  59               	#   print error message
  60 0008 48E7 E080 		movm.l	%d0-%d2/%a0,-(%sp)
  61 000c 487A 0022 		pea	ufmt
  62 0010 4EB9 0000 		jsr	cprintf
  62      0000 
  63 0016 588F      		add.l	#4,%sp
  64 0018 4CD7 0107 		movm.l	(%sp),%d0-%d2/%a0
  65 001c DFFC 0000 		add.l	#16,%sp
  65      0010 
  66 0022 4EF9 0000 		jmp	_exit
  66      0000 
  67               		
  68               	#   print error message
  69               	
  70               	# undefined:	/* former */
  71               	#	move.l	#-1,%d0		/* error code to D0 */
  72               	bios_error_return:
  73 0028 2C5F      		move.l	(%sp)+,%a6	/* restore A6 */
  74 002a 0057 000B 		or.w	#Flags,(%sp)	/* set the N, V & C flags */
  75 002e 4E73      		rte			/* return from exception */
  76               	
  77               	ufmt:
  78 0030 0A55 6E64 		.ascii	"\nUndefined BIOS call\n"
  78      6566 696E 
  78      6564 2042 
  78      494F 5320 
  78      6361 6C6C 
  79 0045 2020 4430 		.asciz	"  D0=%08x  D1=%08x  D2=%08x   A0=%08x\n"
  79      3D25 3038 
  79      7820 2044 
  79      313D 2530 
  79      3878 2020 
  80               	
  81               	
  82               		.even
  83               	bios_trap_entry:
  84 006c 2F0E      		move.l	%a6,-(%sp)		/* save A6 */
  85 006e 4880      		ext.w	%d0			/* extend byte to word < 128 */
  86 0070 0C40 0020 		cmp.w	#bios_vector_lth/4,%d0	/* in range? */
  87 0074 6492      		jbcc	undefined
  88 0076 E588      		lsl.l	#2,%d0			/* multiply by 4 */
  89 0078 2C7B 0006 		move.l	bios_vector_00(%d0.w,%pc),%a6
  90 007c 4ED6      		jmp	(%a6)			/* vector to service routine */
  91               	
  92 007e 0000      		.align	4		/* long word boundary */
  93               	bios_vector_00:
  94 0080 0000 0000 		.long	undefined
  95 0084 0000 0000 		.long	undefined
  96 0088 0000 0000 		.long	bios_sioput	/*  2  */
  97 008c 0000 0000 		.long	bios_siostr
  98 0090 0000 0000 		.long	bios_sioget
  99 0094 0000 0000 		.long	bios_siotst	/*  5  */
 100 0098 0000 0000 		.long	bios_cpuhma	/*  6  */
 101 009c 0000 0000 		.long	bios_cpustop	/*  7  */
 102               	#  8 - 15
 103 00a0 0000 0000 		.long	bios_hma_alloc  /*  8  allocate HighestMA memory */

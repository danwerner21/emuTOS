 135               	bios_cpustop:
 136 0100 2001      		move.l	%d1,%d0		/* push return code */
 137 0102 4EF9 0000 		jmp	_exit
 137      0000 
 138               	
 139               	bios_cpuhma:
 140 0108 2039 0000 		move.l	h_m_a,%d0		/* get HMA+1 address */
 140      0000 
 141 010e 6000 FEF0 		jbra	bios_good_return	/* good return */
 142               	
 143               	bios_hma_alloc:
 144 0112 2039 0000 		move.l	h_m_a,%d0
 144      0000 
 145 0118 0280 FFFF 		and.l	#-4,%d0			/* keep it aligned */
 145      FFFC 
 146 011e 9081      		sub.l	%d1,%d0
 147 0120 6B00 FF06 		jbmi	bios_error_return	/* negative indicates error */
 148 0124 0280 FFFF 		and.l	#-4,%d0			/* keep it aligned */
 148      FFFC 
 149 012a 23C0 0000 		move.l	%d0,h_m_a		/* update Highest Memory Address */
 149      0000 
 150 0130 6000 FECE 		jbra	bios_good_return	/* good return */

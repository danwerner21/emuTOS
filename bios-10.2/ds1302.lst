  22               	.ifndef _mfpic_s
  23               	_mfpic_s 	=	1
  24               	
  25               	# Z80 port address of MF/PIC board (required)
  26               	mf_pic		=	0x40
  27               	
  28               	# Mini-M68k I/O address base
  29               	BOARD_BASE_IO	=	0xFFFF8000
  30               	
  31               	# board base address:
  32               	mfpic_base      =       BOARD_BASE_IO + mf_pic
  33               	
  34               	mf_sio          =       mfpic_base + 8
  35               	mf_ppi          =       mfpic_base + 4
68K GAS  ds1302.s 			page 2


  36               	mf_rtc          =       mfpic_base + 3
  37               	mf_cfg          =       mfpic_base + 2
  38               	mf_202          =       mfpic_base + 0
  39               	
  40               	
  41               	.endif
  42               	
  43               	
  23               	
  24               		.text
  25               	
  26               	rtc_data        =     1               /* Data mask bit - DATA	*/
  27               	rtc_wren        =     2               /* Write enable bit - /WE	*/
  28               	rtc_clk         =     4               /* Clock signal - CLK	*/
  29               	rtc_rst         =     8               /* Reset bit - /RESET	*/
  30               	
  31               	rtc_write_cmd	=	0x80		/* WRITE command */
  32               	rtc_read_cmd	=	0x81		/* READ	command */
  33               	
  34               	
  35               	#;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  36               	#  rtc_get_loc          RTC get location as addressed
  37               	#	Enter with:
  38               	#			Address to get on Stack
  39               	#			RAM = (address) | 0x80
  40               	#			CLOCK = (address) | 0x00
  41               	#	Exit with 	data in D0
  42               	#               All other registers are preserved
  43               	#;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  44               		.globl  rtc_get_loc
  45               	rtc_get_loc:
  46 0000 4E56 0000 		link	%a6,#0
  47 0004 48E7 7000 		movm.l	%d1-%d3,-(%sp)
  48               	
  49 0008 6100 00A2 		bsr	rtc_reset
  50 000c 6100 00A2 		bsr	rtc_reset_off
  51               	
  52 0010 222E 0008 		move.l	8(%a6),%d1		/* get address to D1 bits (7..0) */
  53 0014 D281      		add.l	%d1,%d1
  54 0016 0081 0000 		or.l	#rtc_read_cmd,%d1	/* make into a write command */
  54      0081 
  55 001c 6100 0056 		bsr	rtc_write
  56               	
  57 0020 6100 006E 		bsr	rtc_read		/* read the data value to D1 */
  58               	
  59 0024 6100 008A 		bsr	rtc_reset_off
  60 0028 6100 0082 		bsr	rtc_reset
  61               	
  62 002c 4280      		clr.l	%d0			/* make for a clean return */
  63 002e 1001      		move.b	%d1,%d0	
  64               	
  65 0030 4CEE 000E 		movm.l	(-12,%a6),%d1-%d3
  65      FFF4 
  66 0036 4E5E      		unlk	%a6
  67 0038 4E75      		rts
  68               	
  69               	
68K GAS  ds1302.s 			page 3


  70               	#;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  71               	#  rtc_set_loc          RTC set location as addressed
  72               	#	Enter with:
  73               	#			Address to get on Stack -- ARG1
  74               	#				RAM = (address) | 0x20
  75               	#				CLOCK = (address) | 0x00
  76               	#			Data to write on Stack -- ARG2
  77               	#;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  78               		.globl  rtc_set_loc
  79               	rtc_set_loc:
  80 003a 4E56 0000 		link	%a6,#0
  81 003e 48E7 7000 		movm.l	%d1-%d3,-(%sp)
  82               	
  83 0042 6100 0068 		bsr	rtc_reset
  84 0046 6100 0068 		bsr	rtc_reset_off
  85               	
  86 004a 222E 0008 		move.l	8(%a6),%d1		/* get address to D1 bits (7..0) */
  87 004e D281      		add.l	%d1,%d1
  88 0050 0081 0000 		or.l	#rtc_write_cmd,%d1	/* make into a write command */
  88      0080 
  89 0056 6100 001C 		bsr	rtc_write
  90               	
  91 005a 222E 000C 		move.l	12(%a6),%d1		/* ARG2 is data to write to address */
  92 005e 6100 0014 		bsr	rtc_write
  93               	
  94 0062 6100 004C 		bsr	rtc_reset_off
  95 0066 6100 0044 		bsr	rtc_reset
  96               	
  97 006a 4CEE 000E 		movm.l	(-12,%a6),%d1-%d3
  97      FFF4 
  98 0070 4E5E      		unlk	%a6
  99 0072 4E75      		rts

 106               	#	.globl  rtc_write
 107               	#  write byte in D1 to the DS1302 chip
 108               	rtc_write:
 109 0074 7407      		move.l	#7,%d2
 110               	wr_loop:
 111 0076 7001      		move.l	#rtc_wren/2,%d0		/* write enable, shifted right */
 112 0078 E289      		lsr.l	#1,%d1 			/* bit 0 to X bit */
 113 007a E390      		roxl.l	#1,%d0			/* write enable + low data bit */
 114 007c 6100 0034 		bsr	rtc_out			/* put out the byte */
 115               	
 116 0080 0080 0000 		or.l	#rtc_clk,%d0		/* set the clock bit */
 116      0004 
 117 0086 6100 002A 		bsr	rtc_out
 118               		
 119 008a 51CA FFEA 		dbra	%d2,wr_loop
 120               	
 121 008e 4E75      		rts
 122               	
 123               	
68K GAS  ds1302.s 			page 4


 124               	#	.globl	rtc_read
 125               	#  read byte from the DS1302 chip to D1
 126               	rtc_read:
 127 0090 7407      		move.l	#7,%d2
 128 0092 4281      		clr.l	%d1
 129               	rd_loop:
 130 0094 6100 001A 		bsr	rtc_reset_off		/* WriteEnable off, Reset Off */
 131               	
 132               	/* use a subroutine to introduce appropriate delays of 16 usec. or more */
 133 0098 6100 0024 		bsr	rtc_in			/* get byte to D1 */
 134               	
 135 009c 7004      		move.l	#rtc_clk,%d0		/* clock the chip */
 136 009e 6100 0012 		bsr	rtc_out
 137               	
 138 00a2 E259      		ror.w	#1,%d1			/* accumulate data byte in bits 15..8 */
 139 00a4 51CA FFEE 		dbra	%d2,rd_loop
 140               	
 141 00a8 E089      		lsr.l	#8,%d1
 142               	
 143 00aa 4E75      		rts
 144               	
 145               	
 146               	
 147               	
 148               	/*	rtc_reset
 149               		rtc_reset_off		3 functions using D0 internally
 150               		rtc_out			D3 is used for the time delay
 151               	
 152               	*/
 153               	rtc_reset:
 154 00ac 7008      		move.l	#rtc_rst,%d0		/* Reset, enable read */
 155 00ae 6002      		br.s	rtc_out
 156               	
 157               	rtc_reset_off:
 158 00b0 4280      		clr.l	%d0
 159               		/* fall into rtc_out */
 160               	/*
 161               	  rtc_out()    byte to put into latch is in D0
 162               	*/
 163               	rtc_out:
 164 00b2 11C0 8043 		move.b	%d0,mf_rtc		/* output D0 to the RTC latch */
 165 00b6 4EB9 0000 		jsr	(usec09).l
 165      0000 
 166 00bc 4E75      		rts
 167               	
 168               	/*
 169               	  rtc_in()	input byte to D1
 170               	*/
 171               	rtc_in:
 172               		.rept	4
 172 00be 4E71      	> nop 
 172               	> 
 172 00c0 4E71      	> nop 
 172               	> 
 172 00c2 4E71      	> nop 
 172               	> 
 172 00c4 4E71      	> nop 
68K GAS  ds1302.s 			page 5


 173               		nop
 174               		.endr
 175 00c6 1238 8043 		move.b	mf_rtc,%d1
 176 00ca 4E75      		rts
 177               	

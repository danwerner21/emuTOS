 142               	#  dide_read_id
 143               	#  dide_info		; equivalent
 144               	# -----------------------------------------------------------------------------	
 145               	# Read the 512 byte ID information from the attached drive
 146               	#
 147               	#	arg1	disk number  (D1)
 148               	#	arg2	buffer or NULL	(A0)
 149               	#	A1	disk table pointer
 150               	#	A5	principal M68k I/O address of device
 151               	#
 152               	#-----------------------------------------------------------------------------
 153               		.even
 154               	dide_read_id:
 155               			.globl	dide_info
 156               	dide_info:
 157 008e 206F 0008 		move.l	(buffer,%sp),%a0		/* get buffer address */
 158               	
 159 0092 3008      		move	%a0,%d0				/* test for NULL */
 160 0094 4A80      		tst.l	%d0
 161 0096 672C      		beq.s	short_info			/* LBA & GEOM info only */
 162               	
 163 0098 6100 0114 		bsr	ide_wait_not_busy		/* uses D0, D1 */
 164 009c 664E      		bne.s	read_id_error			/* %D0 == -1 */
 165               	
 166 009e 1029 000A 		move.b	(disk_slave_o,%a1),%d0		/* get slave byte */
 167 00a2 0000 00E0 		or.b	#0xE0,%d0
 168 00a6 1B40 0006 		move.b	%d0,ide_head(%a5)		/* set M/S */
 169               	
 170 00aa 1B7C 00EC 		move.b	#ide_cmd_id,ide_command(%a5)	/* send ID command */
68K GAS  dualide.s 			page 7


 170      0007 
 171               	
 172 00b0 6100 0116 		bsr	ide_wait_drq			/* uses D0, D1 */
 173 00b4 6636      		bne.s	read_id_error			/* %D0 == -1 */
 174               	
 175 00b6 323C 01FF 		move.w	#511,%d1
 176 00ba 508D      		add.l	#ide_data_16,%a5		/* change A5 */
 177               	read_id_loop:
 178 00bc 10D5      		move.b	(%a5),(%a0)+
 179 00be 51C9 FFFC 		dbra.w	%d1,read_id_loop
 180 00c2 518D      		sub.l	#ide_data_16,%a5		/* restore A5 */
 181               	

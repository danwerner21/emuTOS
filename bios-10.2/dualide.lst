  31               	Dual_IDE_port	=	0x80
  32               	
  33               	
  34               	
  35               	arg1	=	4
  36               	arg2	=	arg1+4
  37               	arg3	=	arg2+4
  38               	arg4	=	arg3+4
  39               	
  40               	buffer	= 	arg2
  41               	
  42               	
  43               	dual_ide_A	=	BOARD_BASE_IO + Dual_IDE_port
  44               	dual_ide_B	=	dual_ide_A + 16
  45               	
  46               	/*
  47               	    Enter general dispatch routines with:
  48               		A0 = buffer pointer, if applicable
  49               		A1 = disk structure pointer
  50               		D0 = garbage
  51               		D1 = garbage
  52               		D2 = LBA sector number
  53               		D3 = number of sectors (only 1, for now)
  54               	
  55               	    Stack:
  56               		SP:	return address
  57               			Saved D1 -- disk number (0..7)
  58               			Saved A0 -- buffer pointer
  59               			Saved A1 -- ???
  60               			Saved A5 -- ???
  61               	
  62               	    May Use:
  63               		D0, D1, A0, A1
  64               	    Must Preserve:
  65               		D2-D7, A2-A7
  66               	
  67               	 */
  68               	
  69               	RECAL	=  1
  70               	
  71               		.text
  72               	# -----------------------------------------------------------------------------	
  73               	#  dide_reset
68K GAS  dualide.s 			page 5


  74               	# -----------------------------------------------------------------------------	
  75               	#	arg1	disk number  (D1)
  76               	#	A1	disk table pointer
  77               	#	A5	principal M68k I/O address of device
  78               	#
  79               	#   Returns D1 (in stack) mask of devices present (D0 == 0)
  80               	#   Error return if no devices on unit.
  81               	# -----------------------------------------------------------------------------	
  82               		.even
  83               		.globl	dide_reset
  84               	dide_reset:
  85 0000 207C 0000 		move.l	#0,%a0			/* accumulate D1 mask here */
  85      0000 
  86               	
  87 0006 1B7C 000E 		move.b	#0b00001110,ide_control(%a5)	/* assert SRST, deassert IEN */
  87      000E 
  88 000c 203C 0000 		move.l	#1000,%d0			/* delay 10 ms = 10,000 usec */
  88      03E8 
  89 0012 4EB9 0000 		jsr	usec_delay
  89      0000 
  90 0018 1B7C 000A 		move.b	#0b00001010,ide_control(%a5)	/* deassert SRST, deassert IEN */
  90      000E 
  91 001e 203C 0000 		move.l	#50000,%d0
  91      C350 
  92 0024 4EB9 0000 		jsr	usec_delay			/* delay 500 ms */
  92      0000 
  93               		
  94               	#	cmp.b	#0,ide_head(%a5)
  95               	#	bne.s	reset1
  96 002a 0C2D 0050 		cmp.b	#0x50,ide_status(%a5)		/* check for BUSY=0, RDY=1, SeekComplete=1 */
  96      0007 
  97 0030 6616      		bne.s	reset1
  98               	/* may wish to recalibrate the drive here */
  99               	.if RECAL
 100 0032 0829 0004 		btst	#4,(disk_slave_o,%a1)		/* test SLAVE bit */
 100      000A 
 101 0038 660C      		bne.s	reset10				/* branch if SLAVE */
 102 003a 1B7C 0010 		move.b	#ide_cmd_recal,ide_command(%a5)	/* do a recalibrate of the drive */
 102      0007 
 103 0040 6100 016C 		bsr	ide_wait_not_busy
 104 0044 6602      		bne.s	reset1
 105               	reset10:
 106               	.endif
 107 0046 5288      		add.l	#1,%a0				/* mark drive 0 present */
 108               	reset1:
 109 0048 1B7C 00F0 	       	move.b	#0b11110000,ide_head(%a5)	/* select drive 1 */
 109      0006 
 110 004e 203C 0000 		move.l	#1000,%d0			/* delay 10 ms = 10,000 usec */
 110      03E8 
 111 0054 4EB9 0000 		jsr	usec_delay
 111      0000 
 112 005a 0C2D 0050 		cmp.b	#0x50,ide_status(%a5)		/* check for BUSY=0, RDY=1, SeekComplete=1 */
 112      0007 
 113 0060 6616      		bne.s	reset2
 114               	/* may wish to recalibrate the drive here */
 115               	.if RECAL
 116 0062 0829 0004 		btst	#4,(disk_slave_o,%a1)		/* test SLAVE bit */
68K GAS  dualide.s 			page 6


 116      000A 
 117 0068 670C      		beq.s	reset20				/* branch if MASTER */
 118 006a 1B7C 0010 		move.b	#ide_cmd_recal,ide_command(%a5)	/* do a recalibrate of the drive */
 118      0007 
 119 0070 6100 013C 		bsr	ide_wait_not_busy
 120 0074 6602      		bne.s	reset2
 121               	reset20:
 122               	.endif
 123 0076 5488      		add.l	#2,%a0				/* mark drive 1 present */
 124               	reset2:
 125 0078 1B7C 00E0 	       	move.b	#0b11100000,ide_head(%a5)	/* select drive 0 */
 125      0006 
 126               	
 127 007e 2208      		move.l	%a0,%d1				/* move to D1 */
 128 0080 2F41 0004 		move.l	%d1,arg1(%sp)			/* save in stack */
 129 0084 4280      		clr.l	%d0

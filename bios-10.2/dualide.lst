  22               	.ifndef _allide_s
  23               	_allide_s 	=	1
  24               	
  25               	
  26               	
  27               	max_disk	=  8
  28               	max_floppy	=  2
  29               	
  30               		.comm	disk_table,max_disk*4
  31               	
  32               	/* DISK structure offsets */
  33               	disk_ops_o	=	0		/* operations dispatch ptr */
  34               	disk_lba_o	=	4		/* LBA number of cylinders */
  35               	disk_type_o	=	8		/* byte: disk type */
  36               	disk_port_o	=	9		/* byte: I/O port */
  37               	disk_slave_o	=	10		/* byte: MASTER=0, SLAVE=0x10 (IDE)
  38               							SLAVE=0x01 (SD) */
  39               	disk_status_o	=	11		/* byte: last h/w status */
  40               	disk_geom_o	=	12		/* geometry longword */
  41               	
  42               	
  43               	
  44               	
  45               	
  46               	
  47               	#ide control lines for use with ide_8255_ctl.  Change these 8
68K GAS  dualide.s 			page 3


  48               	#constants to reflect where each signal of the 8255 each of the
  49               	#ide control signals is connected.  All the control signals must
  50               	#be on the same port, but these 8 lines let you connect them to
  51               	#whichever pins on that port.
  52               	
  53               	ide_a0_line	=	0x01		/* direct from 8255 to ide interface */
  54               	ide_a1_line	=	0x02		/* direct from 8255 to ide interface */
  55               	ide_a2_line	=	0x04		/* direct from 8255 to ide interface */
  56               	.ifdef	rd_ide_8255
  57               	/* for the PPIDE driver */
  58               	ide_cs0_line	=	0x08		/* inverter between 8255 and ide interface */
  59               	ide_cs1_line	=	0x10		/* inverter between 8255 and ide interface */
  60               	ide_wr_line	=	0x20		/* inverter between 8255 and ide interface */
  61               	ide_rd_line	=	0x40		/* inverter between 8255 and ide interface */
  62               	ide_rst_line	=	0x80		/* inverter between 8255 and ide interface */
  63               	.else
  64               	/* for the DUALIDE driver */
  65               	ide_cs0_line	=	0x00		/* at the base address */
  66               	ide_cs1_line	=	0x08		/* at the base address + 8 */
  67               	.endif
  68               	
  69               	#------------------------------------------------------------------
  70               	# More symbolic constants... these should not be changed, unless of
  71               	# course the IDE drive interface changes, perhaps when drives get
  72               	# to 128G and the PC industry will do yet another kludge.
  73               	
  74               	#some symbolic constants for the ide registers, which makes the
  75               	#code more readable than always specifying the address pins
  76               	
  77               	ide_data       	=	ide_cs0_line
  78               	ide_err		=	ide_cs0_line + ide_a0_line
  79               	ide_sec_cnt	=	ide_cs0_line + ide_a1_line
  80               	ide_sector     	=	ide_cs0_line + ide_a1_line + ide_a0_line
  81               	ide_cyl_lsb	=	ide_cs0_line + ide_a2_line
  82               	ide_cyl_msb	=	ide_cs0_line + ide_a2_line + ide_a0_line
  83               	ide_head       	=	ide_cs0_line + ide_a2_line + ide_a1_line
  84               	ide_command	=	ide_cs0_line + ide_a2_line + ide_a1_line + ide_a0_line
  85               	ide_status     	=	ide_cs0_line + ide_a2_line + ide_a1_line + ide_a0_line
  86               	
  87               	ide_control	=	ide_cs1_line + ide_a2_line + ide_a1_line
  88               	ide_astatus	=	ide_cs1_line + ide_a2_line + ide_a1_line
  89               	ide_address	=	ide_cs1_line + ide_a2_line + ide_a1_line + ide_a0_line
  90               	.ifndef	rd_ide_8255
  91               	ide_data_16	=	ide_cs1_line
  92               	ide_dma_16	=	ide_cs1_line + ide_a0_line
  93               	.endif
  94               	
  95               	#IDE Command Constants.  These should never change.
  96               	ide_cmd_recal		=	0x10
  97               	ide_cmd_read		=	0x20
  98               	ide_cmd_write		=	0x30
  99               	ide_cmd_init		=	0x91
 100               	ide_cmd_id     		=	0xEC
 101               	ide_cmd_set_feature	=	0xEF
 102               	ide_cmd_spindown	=	0xE0
 103               	ide_cmd_spinup		=	0xE1
 104               	
68K GAS  dualide.s 			page 4


 105               	#Feature requests
 106               	ide_fea_8bit		=	0x01
 107               	ide_fea_16bit		=	0x81

 193 00dc 0280 0000 		and.l	#1,%d0				/* test error flag */
 193      0001 
 194 00e2 6708      		beq.s	read_id_error			/* D0 = 0 if not set */
 195 00e4 102D 0001 		move.b	ide_err(%a5),%d0		/* return error */

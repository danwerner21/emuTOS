 866 030c 51CB FFF4 		dbra	%d3,sdwr1
 867 0310 203C 0000 		move.l	#ERR_TIMEOUT,%d0	/* signal timeout error	*/
 867      0086 
 868               	/* Z flag is clear (NE condition) */

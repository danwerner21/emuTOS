 694               	/*------------------------------------------------------------------------
 695               	; SDsendclks	send clock transitions to the card
 696               	;
 697               	;  Enter with:
 698               	;	D0 =	initial byte to send
 699               	;	D1.W =	count of clock transitions - 1 (must be odd;  15 / 255)
 700               	;
 701               	;  Return with:
 702               	;	D1.W =	-1

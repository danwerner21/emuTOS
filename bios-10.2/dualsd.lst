 622               	
 623               	/*------------------------------------------------------------------------
 624               	; cmd_R1	issue command and get R1 response
 625               	;
 626               	;  Enter with:
 627               	;	A0	pointer to the command (5 of 6 bytes)
 628               	;
 629               	;  Uses:
 630               	;	B & C registers
 631               	;
 632               	;  Exit with:
 633               	;	Z flag set (EQ):
 634               	;		D0.b is the response to the command
 635               	;	Z flag clear (NE):
 636               	;		D0 is the error code
 637               	;	A0 is incremented by 5
 638               	;
 639               	;  Errors:
 640               	;	ERR_TIMEOUT	if no response within 8 byte times (NE condition)
 641               	;	ERR_NO_MEDIA
 642               	;
 643               	;------------------------------------------------------------------------
 644               	cmd_R1:
 645               		call	SDselect
 646               		ret	nz
 647               	
 648               		ld	b,#6		; all commands are 6 bytes
 649               	cmr1:
 650               		ld	c,(hl)		; get a byte of the command
 651               		inc	hl		; increment the pointer
 652               		call	SDput		; put out the byte
 653               		djnz	cmr1		; loop back
 654               	
 655               		ld	b,#9			; response must come within 8 chars
 656               	cmr2:	call	SDget
 657               		ld	a,c			; response in A & C (no error)
 658               		ld	hw_status-instance(IY),c  ; save response in Status byte
 659               		bit	7,c			; test high bit
 660               		ret	z			; return with Z set
 661               		djnz	cmr2			; does not touch the Flags
 662               				; NZ condition is guaranteed here
 663               		ld	a,c			; error byte in A
68K GAS  dualsd.s 			page 16


 664               		ld	c,#ERR_TIMEOUT		; return error code
 665               		ret				; return NZ if no response
 666               	*/
 667               		.even
 668               	cmd_R1:
 669 0268 48A7 3000 		movem	%d2-%d3,-(%sp)		/* save registers */
 670 026c 61B4      		bsr.s	SDselect
 671 026e 6620      		 bne.s	cmdr19
 672 0270 7605      		move.l	#6-1,%d3
 673               	cmdr11:
 674 0272 1018      		move.b	(%a0)+,%d0		/* get byte to put out	*/
 675 0274 61D8      		bsr.s	SDput			/* put out the command byte */
 676 0276 51CB FFFA 		dbra	%d3,cmdr11		/* put out 5 bytes	*/
 677               	
 678               	/* the command has been sent */
 679               			
 680 027a 7608      		move.l	#8,%d3			/* response must come within 8 chars */
 681               	cmdr13:
 682 027c 61B4      		bsr.s	SDget			/* get a character */
 683 027e 1340 000B 		move.b	%d0,disk_status_o(%a1)	/* save disk status byte */
 684 0282 0800 0007 		btst	#7,%d0			/* test hi-bit (7) */
 685 0286 6708      		beq.s	cmdr19			/* return with Z flag set */
 686 0288 51CB FFF2 		dbra	%d3,cmdr13		/* loop back */
 687               	
 688 028c 303C 0086 		move.w	#ERR_TIMEOUT,%d0	/* clear Zero flag, return error */
 689               	cmdr19:
 690 0290 4C9F 000C 		movem	(%sp)+,%d2-%d3		/* restore registers */
 691 0294 4E75      		rts

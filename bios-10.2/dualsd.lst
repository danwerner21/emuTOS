  41               	dual_SD_sel	=	dual_ide_A + SD_select		/* Selection Reg */
  42               	
  43               	
  44               	/*
  45               	    Enter general dispatch routines with:
  46               		A0 = buffer pointer, if applicable
  47               		A1 = disk structure pointer
  48               		D0 = garbage
  49               		D1 = garbage
  50               		D2 = LBA sector number
  51               		D3 = number of sectors (only 1, for now)
  52               	
  53               	    Stack:
  54               		SP:	return address
  55               			Saved D1 -- disk number (0..7)
  56               			Saved A0 -- buffer pointer
  57               			Saved A1 -- ???
  58               			Saved A5 -- ???
  59               	
  60               	    May Use:
  61               		D0, D1, A0, A1
  62               	    Must Preserve:
68K GAS  dualsd.s 			page 5


  63               		D2-D7, A2-A7
  64               	
  65               	 */
  66               	
  67               	RECAL	=  1
  68               	
  69               		.text
  70               	# -----------------------------------------------------------------------------	
  71               	#  dsd_reset
  72               	# -----------------------------------------------------------------------------	
  73               	#	arg1	disk number  (D1)
  74               	#	A1	disk table pointer
  75               	#	A5	principal M68k I/O address of device
  76               	#
  77               	#   Returns D1 (in stack) mask of devices present (D0 == 0)
  78               	#   Error return if no devices on unit.
  79               	# -----------------------------------------------------------------------------	
  80               		.even
  81               		.globl	dsd_reset
  82               	dsd_reset:
  83 0000 207C 0000 		move.l	#0,%a0			/* accumulate D1 mask here */
  83      0000 
  84               	
  85 0006 1B7C 000E 		move.b	#0b00001110,ide_control(%a5)	/* assert SRST, deassert IEN */
  85      000E 
  86 000c 203C 0000 		move.l	#1000,%d0			/* delay 10 ms = 10,000 usec */
  86      03E8 
  87 0012 4EB9 0000 		jsr	usec_delay
  87      0000 
  88 0018 1B7C 000A 		move.b	#0b00001010,ide_control(%a5)	/* deassert SRST, deassert IEN */
  88      000E 
  89 001e 203C 0000 		move.l	#50000,%d0
  89      C350 
  90 0024 4EB9 0000 		jsr	usec_delay			/* delay 500 ms */
  90      0000 
  91               		
  92               	#	cmp.b	#0,ide_head(%a5)
  93               	#	bne.s	reset1
  94 002a 0C2D 0050 		cmp.b	#0x50,ide_status(%a5)		/* check for BUSY=0, RDY=1, SeekComplete=1 */
  94      0007 
  95 0030 6616      		bne.s	reset1
  96               	/* may wish to recalibrate the drive here */
  97               	.if RECAL
  98 0032 0829 0004 		btst	#4,(disk_slave_o,%a1)		/* test SLAVE bit */
  98      000A 
  99 0038 660C      		bne.s	reset10				/* branch if SLAVE */
 100 003a 1B7C 0010 		move.b	#ide_cmd_recal,ide_command(%a5)	/* do a recalibrate of the drive */
 100      0007 
 101 0040 6100 013E 		bsr	ide_wait_not_busy
 102 0044 6602      		bne.s	reset1
 103               	reset10:
 104               	.endif
 105 0046 5288      		add.l	#1,%a0				/* mark drive 0 present */
 106               	reset1:
 107 0048 1B7C 00F0 	       	move.b	#0b11110000,ide_head(%a5)	/* select drive 1 */
 107      0006 
 108 004e 203C 0000 		move.l	#1000,%d0			/* delay 10 ms = 10,000 usec */
68K GAS  dualsd.s 			page 6


 108      03E8 
 109 0054 4EB9 0000 		jsr	usec_delay
 109      0000 
 110 005a 0C2D 0050 		cmp.b	#0x50,ide_status(%a5)		/* check for BUSY=0, RDY=1, SeekComplete=1 */
 110      0007 
 111 0060 6616      		bne.s	reset2
 112               	/* may wish to recalibrate the drive here */
 113               	.if RECAL
 114 0062 0829 0004 		btst	#4,(disk_slave_o,%a1)		/* test SLAVE bit */
 114      000A 
 115 0068 670C      		beq.s	reset20				/* branch if MASTER */
 116 006a 1B7C 0010 		move.b	#ide_cmd_recal,ide_command(%a5)	/* do a recalibrate of the drive */
 116      0007 
 117 0070 6100 010E 		bsr	ide_wait_not_busy
 118 0074 6602      		bne.s	reset2
 119               	reset20:
 120               	.endif
 121 0076 5488      		add.l	#2,%a0				/* mark drive 1 present */
 122               	reset2:
 123 0078 1B7C 00E0 	       	move.b	#0b11100000,ide_head(%a5)	/* select drive 0 */
 123      0006 
 124               	
 125 007e 2208      		move.l	%a0,%d1				/* move to D1 */
 126 0080 2F41 0004 		move.l	%d1,arg1(%sp)			/* save in stack */
 127 0084 4280      		clr.l	%d0
 128 0086 4A01      		tst.b	%d1
 129 0088 6602      		bne.s	reset3
 130 008a 7001      		move.l	#1,%d0				/* error return */
 131               	reset3:
 132 008c 4E75      		rts

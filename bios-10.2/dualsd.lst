 822               	/*
 823               	;------------------------------------------------------------------------
 824               	; SDwaitrdy	wait for card to become ready
 825               	;
 826               	;  Enter with:
 827               	;	nothing
 828               	;
 829               	;  Uses:
 830               	;	B & C registers
 831               	;
 832               	;  Return with:
 833               	;	Z flag = 1	no error, character+1 in C
68K GAS  dualsd.s 			page 19


 834               	;	Z flag = 0	error, timeout; B reg == 1
 835               	;
 836               	;------------------------------------------------------------------------
 837               	SDwaitrdy:
 838               		call	SDselect	; assert Chip Select
 839               		ret	nz
 840               	
 841               		ld	b,#0x7F		; count 0x7F7F

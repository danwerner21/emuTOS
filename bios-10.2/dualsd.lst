 847               		djnz	waitrdy1
 848               		dec	timeout-instance(IY)
 849               		jr	nz,waitrdy1	; outer count loop
 850               		
 851               		or	a,c		; clear the Z flag (C != 0)
 852               		ld	c,#ERR_TIMEOUT	; return error code with Z flag clear
 853               		ret			; NZ is flagged

  26               	
  27               	USE_CRCs	=	1		/* CRC16's or not	*/
  28               	
  29               	Dual_SD_port	=	0x08		/* Z80 port $08		*/
  30               	
  31               	arg1	=	4
  32               	arg2	=	arg1+4
  33               	arg3	=	arg2+4
  34               	arg4	=	arg3+4
  35               	
  36               	buffer	= 	arg2
  37               	
  38               	SD_operation	=	0	/* kept in A5 */
  39               	SD_select	=	1

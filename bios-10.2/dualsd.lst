 981               		ld	h,c
 982               		call	SDget			; the R7 response
 983               		ld	l,c
 984               		push	hl
 985               		call	SDget			;   is R1 + 4 more bytes
 986               		ld	h,c
 987               		call	SDget			; **
 988               		ld	l,c
 989               		push	hl
 990               		ld	hl,#cmd8fmt
 991               		push	hl
 992               		.globl	_cprintf
 993               		call	_cprintf
 994               		pop	af
 995               		pop	af
 996               		pop	af
 997               		jr	cmd8end
 998               	cmd8fmt:	.asciz	"CMD8 v.2 response: 0x%04lx\n"
 999               	cmd8end:
 1000               	.else
 1001               		call	SDget			; v.2 card returns 4 more bytes
 1002               		call	SDget			; v.2 card returns 4 more bytes
68K GAS  dualsd.s 			page 22


 1003               		call	SDget			; v.2 card returns 4 more bytes
 1004               		call	SDget			; v.2 card returns 4 more bytes
 1005               	.endif
 1006               	inc8:
 1007               		call	SDdone			; ignore any error
 1008               	
 1009               		ld	b,#0			; try 256 times to do the init
 1010               	inc10:

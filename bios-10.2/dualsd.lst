 718               	
 719               	/*------------------------------------------------------------------------
 720               	; SDdone	complete a transaction
68K GAS  dualsd.s 			page 17


 721               	;
 722               	;  Enter with:
 723               	;	Nothing
 724               	;
 725               	;  Return with:
 726               	;	All registers are preserved
 727               	;	Flags are preserved, too
 728               	;
 729               	;	The card is deselected!!!  (Chip_Select is cleared)
 730               	;
 731               	;------------------------------------------------------------------------*/
 732               		.even
 733               	SDdone:
 734 02a4 48A7 E000 		movem	%d0-%d2,-(%sp)		/* save 3 registers */
 735 02a8 40C2      		move	%sr,%d2			/* save CCR+SR */
 736               	
 737 02aa 7001      		move.l	#SD_DATA,%d0 		/* Chip Select OFF, Clock Low, Data Idle (high) */
 738 02ac 720F      		move.l	#15,%d1
 739 02ae 61E6      		bsr.s	SDsendclks
 740               	
 741 02b0 46C2      		move	%d2,%sr			/* restore CCR */
 742 02b2 4C9F 0007 		movem	(%sp)+,%d0-%d2		/* restore registers */
 743 02b6 4E75      		rts				/* return */
 744               	
 745               	
 746               	
 747               	/*------------------------------------------------------------------------
 748               	; SDcmdset	Set up a command in the stack
 749               	;
 750               	;  Enter with:
 751               	;	D0	Command byte
 752               	;	D2	parameter word
 753               	;
 754               	;	C	Command byte
 755               	;	DE	high order parameter word
 756               	;	HL	low order parameter word
 757               	;
 758               	;  Return with:
 759               	;	A0	points to command in the stack
 760               	;	SP	decremented by 8 (stack alignment is maintained)
 761               	;
 762               	;	HL	points at stack top
 763               	;	SP	is decremented by 6 (size of the command)
 764               	;	BC & DE are trashed
 765               	;
 766               	;	The sixth byte of the command is the CRC7 value needed
 767               	;------------------------------------------------------------------------
 768               	SDcmdset:
 769               		ld	b,h
 770               		ex	(sp),hl		; stack has  L,X
 771               					; HL = return address
 772               		ld	a,c
 773               		ld	c,e
 774               		push	bc		; stack has  E,H,L,X
 775               		ld	e,a
 776               		push	de		; stack has  C,D,E,H,L,X
 777               		push	hl		; save return address
68K GAS  dualsd.s 			page 18


 778               		ld	hl,#2		; address of command
 779               		add	hl,sp		; HL -> command
 780               	.if USE_CRCs
 781               		push	hl		; save command pointer
 782               		ld	b,#5		; CRC7 calculated over 5 bytes
 783               		call	calcCRC7
 784               		ld	(hl),e		; store CRC7 calculation
 785               		pop	hl		; restore HL
 786               	.endif
 787               		ret
 788               	*/
 789               		.even
 790               	SDcmdset:
 791 02b8 3F08      		move	%a0,-(%sp)	/* this loc. and return address will
 792               						become the command area of 6 bytes */
 793 02ba 304F      		move	%sp,%a0		/* A0 is command pointer */
 794 02bc 3F2F 0004 		move	4(%sp),-(%sp)	/* stack the return address */
 795               	
 796 02c0 48A7 2020 		movem	%d2/%a2,-(%sp)	/* register save */
 797               	
 798 02c4 30C0      		move.w	%d0,(%a0)+	/* SP+1 is command byte */
 799               	.if USE_CRCs
 800 02c6 0240 00FF 		and.w	#0xFF,%d0
 801 02ca 45F9 0000 		lea	table7,%a2	/* address table from A2 */
 801      0000 
 802 02d0 7204      		move.l	#4,%d1		/* 4 parameter bytes */
 803 02d2 6006      		bra.s	cms4
 804               	cms2:
 805 02d4 E19A      		rol.l	#8,%d2

 710 0298 0A00 0002 		eori.b	#SD_CLK,%d0		/* invert clock */
 711               	/*  count 15..0 or 255..0  		*/
 712 029c 51C9 FFF8 		dbra	%d1,SDsendclks		/* loop D1.w+1 times */
 713               	
 714 02a0 1A80      		move.b	%d0,(%a5)		/* set initial clock value */
 715 02a2 4E75      		rts

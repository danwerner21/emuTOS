 202               	#  dsd_read
 203               	# -----------------------------------------------------------------------------	
 204               	#	;read a sector, specified by the 4 bytes in "lba",
 205               	#	;Return, acc is zero on success, non-zero for an error
 206               	#
 207               	#	arg1	disk number  (D1)
 208               	#	arg2	buffer	(A0)
 209               	#	A1	disk table pointer
 210               	#	D2	LBA address
 211               	#	D3	sector count (assumed to be 1)
 212               	#	A5	principal M68k I/O address of device
 213               	#
 214               	#
 215               	#-----------------------------------------------------------------------------
68K GAS  dualsd.s 			page 8


 216               		.even
 217               		.globl	dsd_read
 218               	dsd_read:
 219 00c0 206F 0008 		move.l	(buffer,%sp),%a0		/* get buffer address */
 220 00c4 7005      		move.l	#5,%d0				/* error code */
 221 00c6 B4A9 0004 		cmp.l	(disk_lba_o,%a1),%d2		/* check lba address */
 222 00ca 6432      		bcc.s	read_error
 223               	
 224 00cc 7004      		move.l	#4,%d0				/* error code */
 225 00ce 0C83 0000 		cmp.l	#1,%d3
 225      0001 
 226 00d4 6628      		bne.s	read_error			/* for now */
 227               	
 228 00d6 6100 00A8 		bsr	ide_wait_not_busy
 229 00da 6622      		bne.s	read_error			/* %D0 == -1 */
 230               	
 231 00dc 6100 00D6 		bsr	wr_lba
 232               	
 233 00e0 1B7C 0020 		move.b	#ide_cmd_read,ide_command(%a5)	/* send ID command */
 233      0007 
 234               	
 235 00e6 6100 00B2 		bsr	ide_wait_drq
 236 00ea 6612      		bne.s	read_error			/* %D0 == -1 */
 237               	
 238 00ec 323C 01FF 		move.w	#511,%d1
 239 00f0 508D      		add.l	#ide_data_16,%a5
 240               	read_loop:
 241 00f2 10D5      		move.b	(%a5),(%a0)+
 242 00f4 51C9 FFFC 		dbra.w	%d1,read_loop
 243 00f8 518D      		sub.l	#ide_data_16,%a5
 244               	
 245 00fa 6000 FFA6 		bra	get_error_status
 246               	
 247               	#	clr.l	%d0			/* signal no error */
 248               	read_error:
 249 00fe 4E75      		rts

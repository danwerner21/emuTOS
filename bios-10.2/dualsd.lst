 139               	# -----------------------------------------------------------------------------	
 140               	#  dsd_read_id
 141               	#  dsd_info		; equivalent
 142               	# -----------------------------------------------------------------------------	
 143               	# Read the 512 byte ID information from the attached drive
 144               	#
 145               	#	arg1	disk number  (D1)
 146               	#	arg2	buffer or NULL	(A0)
 147               	#	A1	disk table pointer
 148               	#	A5	principal M68k I/O address of device
 149               	#
 150               	#-----------------------------------------------------------------------------
 151               		.even
 152               	dsd_read_id:
 153               			.globl	dsd_info
 154               	dsd_info:
 155 008e 206F 0008 		move.l	(buffer,%sp),%a0		/* get buffer address */
 156               	
 157 0092 3008      		move	%a0,%d0				/* test for NULL */
 158 0094 4A80      		tst.l	%d0
 159               	.if 0
68K GAS  dualsd.s 			page 7


 160               		beq.s	short_info			/* LBA & GEOM info only */
 161               	
 162               		bsr	ide_wait_not_busy		/* uses D0, D1 */
 163               		bne.s	read_id_error			/* %D0 == -1 */
 164               	
 165               		move.b	(disk_slave_o,%a1),%d0		/* get slave byte */
 166               		or.b	#0xE0,%d0
 167               		move.b	%d0,ide_head(%a5)		/* set M/S */
 168               	
 169               		move.b	#ide_cmd_id,ide_command(%a5)	/* send ID command */
 170               	
 171               		bsr	ide_wait_drq			/* uses D0, D1 */
 172               		bne.s	read_id_error			/* %D0 == -1 */
 173               	
 174               		move.w	#511,%d1
 175               		add.l	#ide_data_16,%a5		/* change A5 */
 176               	read_id_loop:
 177               		move.b	(%a5),(%a0)+
 178               		dbra.w	%d1,read_id_loop
 179               		sub.l	#ide_data_16,%a5		/* restore A5 */
 180               	.endif
 181               	
 182               	short_info:
 183 0096 2429 0004 		move.l	disk_lba_o(%a1),%d2		/* LBA info return */
 184 009a 2F42 0004 		move.l	%d2,arg1(%sp)
 185 009e 2429 000C 		move.l	disk_geom_o(%a1),%d2		/* geometry return */
 186               	
 187               	get_error_status:
 188 00a2 6100 00DC 		bsr	ide_wait_not_busy		/* uses D0, D1 */
 189 00a6 6616      		bne.s	read_id_error			/* %D0 == -1 */
 190               	
 191 00a8 4280      		clr.l	%d0
 192 00aa 102D 0007 		move.b	ide_status(%a5),%d0
 193 00ae 0280 0000 		and.l	#1,%d0				/* test error flag */
 193      0001 
 194 00b4 6708      		beq.s	read_id_error			/* D0 = 0 if not set */
 195 00b6 102D 0001 		move.b	ide_err(%a5),%d0		/* return error */
 196 00ba 0040 0800 		or.w	#0x800,%d0			/* show error code */
 197               	read_id_error:
 198 00be 4E75      		rts

  34               	disk_lba_o	=	4		/* LBA number of cylinders */
68K GAS  dualsd.s 			page 2


  35               	disk_type_o	=	8		/* byte: disk type */
  36               	disk_port_o	=	9		/* byte: I/O port */
  37               	disk_slave_o	=	10		/* byte: MASTER=0, SLAVE=0x10 (IDE)
  38               							SLAVE=0x01 (SD) */
  39               	disk_status_o	=	11		/* byte: last h/w status */
  40               	disk_geom_o	=	12		/* geometry longword */

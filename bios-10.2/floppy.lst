  30               	fdc_parameters:
  31 0000 0000 0000 		.long 0
  32 0004 0000 0000 		.long 0
  33 0008 0000 0000 		.long HD1200
  34 000c 0000 0000 		.long DD720
  35 0010 0000 0000 		.long HD144
  36 0014 0000 0000 		.long 0
  37 0018 0000 0000 		.long 0
  38 001c 0000 0000 		.long 0

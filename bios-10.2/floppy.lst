  41               		.globl	enable
  42               		.globl	disable
  43               		.even
  44               	/* enable all interrupts by going to interrupt level 000 */
  45               	enable:
  46 0020 027C F8FF 		and.w	#0xF8FF,%sr	/* allow all interrupts */
  47 0024 4E75      		rts
  48               	
  49               	/* disable all interrupts by going to interrupt level 111 (7) */
  50               	disable:
  51 0026 007C 0700 		or.w	#0x0700,%sr	/* disallow all interrupts */
  52 002a 4E75      		rts
  53               	
  54               		.globl	floppy_interrupt_1
  55               		.even
  56               	floppy_interrupt_1:
  57 002c 48E7 C0C0 		movm.l	%d0/%d1/%a0/%a1,-(%sp)		/* save the C-call registers */
  58               	
68K GAS  floppy.s 			page 4


  59 0030 4EB9 0000 		jsr	fdcint		/* written in C */
  59      0000 
  60               	
  61 0036 1038 A040 		move.b	(mf_202 + eoi*256),%d0		/* signal End of Interrupt */
  62 003a 4CDF 0303 		movm.l	(%sp)+,%d0/%d1/%a0/%a1		/* restore the registers */
  63 003e 4E73      		rte
  64               	
  65               	
  66               	
  67               	
  68               	
  69               	arg1	=	4
  70               	arg2	=	arg1+4
  71               	arg3	=	arg2+4
  72               	arg4	=	arg3+4
  73               	
  74               	buffer	= 	arg2
  75               	
  76               	
  77               	
  78               	/*
  79               	    Enter general dispatch routines with:
  80               		A0 = buffer pointer, if applicable
  81               		A1 = disk structure pointer
  82               		D0 = garbage
  83               		D1 = garbage
  84               		D2 = LBA sector number
  85               		D3 = number of sectors (only 1, for now)
  86               	
  87               	    Stack:
  88               		SP:	return address
  89               			Saved D1 -- disk number (0..7)
  90               			Saved A0 -- buffer pointer
  91               			Saved A1 -- ???
  92               			Saved A5 -- ???
  93               	
  94               	    May Use:
  95               		D0, D1, A0, A1
  96               	    Must Preserve:
  97               		D2-D7, A2-A7
  98               	
  99               	 */
 100               	
 101               	# -----------------------------------------------------------------------------	
 102               	#  floppy_reset
 103               	# -----------------------------------------------------------------------------	
 104               	#	arg1	disk number  (D1)
 105               	#	A1	disk table pointer
 106               	#	A5	principal M68k I/O address of device
 107               	#
 108               	#   Returns D1 (in stack) mask of devices present (D0 == 0)
 109               	#   Error return if no devices on unit.
 110               	# -----------------------------------------------------------------------------	
 111               		.even
 112               		.globl	floppy_reset
 113               	floppy_reset:
 114 0040 70FF      		move.l	#-1,%d0		/* error return */
68K GAS  floppy.s 			page 5


 115 0042 4E75      		rts
 116               	.if 0
 117               		move.l	#0,%a0			/* accumulate D1 mask here */
 118               	
 119               		move.b	#0b00001110,ide_control(%a5)	/* assert SRST, deassert IEN */
 120               		move.l	#1000,%d0			/* delay 10 ms = 10,000 usec */
 121               		jsr	usec_delay
 122               		move.b	#0b00001010,ide_control(%a5)	/* deassert SRST, deassert IEN */
 123               		move.l	#50000,%d0
 124               		jsr	usec_delay			/* delay 500 ms */
 125               		
 126               	#	cmp.b	#0,ide_head(%a5)
 127               	#	bne.s	reset1
 128               		cmp.b	#0x50,ide_status(%a5)		/* check for BUSY=0, RDY=1, SeekComplete=1 */
 129               		bne.s	reset1
 130               	/* may wish to recalibrate the drive here */
 131               	.if RECAL
 132               		btst	#4,(disk_slave_o,%a1)		/* test SLAVE bit */
 133               		bne.s	reset10				/* branch if SLAVE */
 134               		move.b	#ide_cmd_recal,ide_command(%a5)	/* do a recalibrate of the drive */
 135               		bsr	ide_wait_not_busy
 136               		bne.s	reset1
 137               	reset10:
 138               	.endif
 139               		add.l	#1,%a0				/* mark drive 0 present */
 140               	reset1:
 141               	       	move.b	#0b11110000,ide_head(%a5)	/* select drive 1 */
 142               		move.l	#1000,%d0			/* delay 10 ms = 10,000 usec */
 143               		jsr	usec_delay
 144               		cmp.b	#0x50,ide_status(%a5)		/* check for BUSY=0, RDY=1, SeekComplete=1 */
 145               		bne.s	reset2
 146               	/* may wish to recalibrate the drive here */
 147               	.if RECAL
 148               		btst	#4,(disk_slave_o,%a1)		/* test SLAVE bit */
 149               		beq.s	reset20				/* branch if MASTER */
 150               		move.b	#ide_cmd_recal,ide_command(%a5)	/* do a recalibrate of the drive */
 151               		bsr	ide_wait_not_busy
 152               		bne.s	reset2
 153               	reset20:
 154               	.endif
 155               		add.l	#2,%a0				/* mark drive 1 present */
 156               	reset2:
 157               	       	move.b	#0b11100000,ide_head(%a5)	/* select drive 0 */
 158               	
 159               		move.l	%a0,%d1				/* move to D1 */
 160               		move.l	%d1,arg1(%sp)			/* save in stack */
 161               		clr.l	%d0
 162               		tst.b	%d1
 163               		bne.s	reset3
 164               		move.l	#1,%d0				/* error return */
 165               	reset3:
 166               		rts
 167               	.endif

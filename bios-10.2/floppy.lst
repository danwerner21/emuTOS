 173               	# -----------------------------------------------------------------------------	
 174               	#  floppy_info		
 175               	# -----------------------------------------------------------------------------	
 176               	# Read the 512 byte ID information from the attached drive
 177               	#
 178               	#	arg1	disk number  (D1)
 179               	#	arg2	buffer or NULL	(A0)
 180               	#	A1	disk table pointer
 181               	#	A5	principal M68k I/O address of device
 182               	#
 183               	#	int fdc_info(int lba, int geom, byte disk_no);
 184               	#		set lba & geom for return
 185               	#-----------------------------------------------------------------------------
 186               		.even
 187               		.globl	floppy_info
 188               	floppy_info:
 189 0044 518F      		sub.l	#8,%sp		/* make space on stack */
 190 0046 4EB9 0000 		jsr	fdc_info	/* fdc_info(byte disk#) */
 190      0000 
 191 004c 4CDF 0006 		movm.l	(%sp)+,%d1/%d2	/* return values */
 192               				/* return D0 */
 193 0050 4E75      		rts
 194               	
 195               	
 196               	
 197               		
 198               	# -----------------------------------------------------------------------------	
 199               	#  floppy_read
 200               	# -----------------------------------------------------------------------------	
 201               	#	;read a sector, specified by the 4 bytes in "lba",
 202               	#	;Return, acc is zero on success, non-zero for an error
 203               	#
 204               	#	arg1	disk number  (D1)
 205               	#	arg2	buffer	(A0)
 206               	#	A1	disk table pointer
 207               	#	D2	LBA address
 208               	#	D3	sector count (assumed to be 1)
 209               	#	A5	principal M68k I/O address of device
 210               	#
 211               	#
 212               	#-----------------------------------------------------------------------------
 213               		.even
 214               		.globl	floppy_read
 215               	floppy_read:
 216 0052 70FF      		move.l	#-1,%d0		/* error return */
 217 0054 4E75      		rts
 218               	.if 0
 219               		move.l	(buffer,%sp),%a0		/* get buffer address */
 220               		move.l	#5,%d0				/* error code */
 221               		cmp.l	(disk_lba_o,%a1),%d2		/* check lba address */
 222               		bcc.s	read_error
 223               	
 224               		move.l	#4,%d0				/* error code */
 225               		cmp.l	#1,%d3
 226               		bne.s	read_error			/* for now */
 227               	
68K GAS  floppy.s 			page 7


 228               		bsr	ide_wait_not_busy
 229               		bne.s	read_error			/* %D0 == -1 */
 230               	
 231               		bsr	wr_lba
 232               	
 233               		move.b	#ide_cmd_read,ide_command(%a5)	/* send ID command */
 234               	
 235               		bsr	ide_wait_drq
 236               		bne.s	read_error			/* %D0 == -1 */
 237               	
 238               		move.w	#511,%d1
 239               		add.l	#ide_data_16,%a5
 240               	read_loop:
 241               		move.b	(%a5),(%a0)+
 242               		dbra.w	%d1,read_loop
 243               		sub.l	#ide_data_16,%a5
 244               	
 245               		bra	get_error_status
 246               	
 247               	#	clr.l	%d0			/* signal no error */
 248               	read_error:
 249               		rts
 250               	.endif

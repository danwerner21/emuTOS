  36               	
  37               	
  38               	/*
  39               	   memtest0:
  40               	   	Initializes D3, D4, D6 and falls into memtest3:   
  41               	   	
  42               	   	
  43               	   	
  44               	   	
  45               	   memtest3:
  46               		
  47               	   Enter with:
  48               	   	D3.b  is the saved X flag; must be 0x00 or 0xFFFF
  49               	   	D4 is the LONG pattern used for the test
  50               	   	D6 is the cumulative failure count
  51               	
  52               		A0 is the highest address to test + 1
  53               		A1 is the lowest address to test
  54               		A6 is the return address
  55               	
  56               	   Returns:
  57               		D6 is the cumulative failure count
68K GAS  memtest3.s 			page 2


  58               		    If counting from 0, then the caller must initialize D6
  59               		D3.b is the saved X flag
  60               		D4 is the UPDATED pattern
  61               		
  62               	   Uses:
  63               	   	A2 is the working address register
  64               	   	A3 to save D3
  65               	   	A4 to save D4
  66               		A6 used for the return address
  67               	
  68               	   Preserves:
  69               	   	D0
  70               	   	D5
  71               		D7
  72               		A0
  73               		A1
  74               		A5
  75               		SP
  76               	*/
  77               	
  78               		.globl	_memtest3
  79               		.globl	_memtest0
  80               	
  81               	memtest0:
  82 0000 2C5F      		move.l	(%sp)+,%a6	/* get the return address */
  83               	_memtest0:	/* start the error count at 0 */
  84 0002 4286      		clr.l	%d6		/* start a new count from zero */
  85 0004 283C 63C1 		move.l	#TEST_PATTERN1,%d4
  85      C783 
  86 000a 76FF      		move.l	#-1,%d3		/* X-flag is set */
  87 000c 6002      		jbra	_memtest3
  88               		
  89               	memtest3:
  90 000e 2C5F      		move.l	(%sp)+,%a6	/* get the return address */
  91               	_memtest3:			/* entry to use no stack  */
  92 0010 2408      		move.l	%a0,%d2
  93 0012 9489      		sub.l	%a1,%d2		/* D2 is byte count to test */
  94               		
  95 0014 2202      		move.l	%d2,%d1		/* D1 does the counting; D2 is saved */
  96 0016 2449      		move.l	%a1,%a2		/* A2 is the start address */
  97               		
  98 0018 E489      		lsr.l	#2,%d1		/* D1 is the LONG count */
  99 001a 2643      		move.l	%d3,%a3		/* save X flag */
 100 001c 2844      		move.l	%d4,%a4		/* save pattern */
 101               		
 102 001e D603      		add.b	%d3,%d3		/* restore the X flag */
 103 0020 6006      		br.s	mt_start3	/* start the counting */
 104               	mt_loop1:
 105 0022 4841      		swap	%d1
 106               	mt_loop2:
 107 0024 E394      		roxl.l	#1,%d4
 108 0026 24C4      		move.l	%d4,(%a2)+
 109               	mt_start3:
 110 0028 51C9 FFFA 		dbra	%d1,mt_loop2
 111 002c 4841      		swap	%d1
 112 002e 51C9 FFF2 		dbra	%d1,mt_loop1
 113               	
68K GAS  memtest3.s 			page 3


 114               	/* now the compare loop */
 115 0032 280C      		move.l	%a4,%d4		/* original pattern */
 116 0034 260B      		move.l	%a3,%d3		/* original X flag */
 117               	
 118 0036 2449      		move.l	%a1,%a2		/* original start address */
 119 0038 2202      		move.l	%d2,%d1		/* original byte count */
 120               		
 121 003a E489      		lsr.l	#2,%d1		/* ulterior motives for doing this shift here */
 122 003c 6004      		br.s	mt_start4	/* start the count */
 123               		
 124               	/* handle counting errors here */
 125               	mt_error1:
 126 003e 9703      		subx.b	%d3,%d3		/* save the X-flag */
 127 0040 5286      		add.l	#1,%d6		/* count the error */
 128               	mt_start4:
 129 0042 D603      		add.b	%d3,%d3		/* restore the X-flag */
 130 0044 003C 0004 		or	#4,%ccr		/* set the Z flag */
 131 0048 6006      		br.s	mt_start5	/* re-enter the loop */
 132               		
 133               	mt_loop3:
 134 004a 4841      		swap	%d1
 135               	mt_loop4:
 136 004c E394      		roxl.l	#1,%d4
 137 004e B89A      		cmp.l	(%a2)+,%d4	/* compare memory to pattern */
 138               					/* compare does not touch the X-flag */
 139               	mt_start5:
 140 0050 56C9 FFFA 		dbne	%d1,mt_loop4	/* inner loop */
 141 0054 66E8      		jbne	mt_error1	/* jump on compare error */
 142               	/* no error occurred on the last iteration */
 143 0056 4841      		swap	%d1
 144 0058 51C9 FFF0 		dbra	%d1,mt_loop3	/* outer loop */
 145               	
 146 005c 9703      		subx.b	%d3,%d3		/* save the X-flag */
 147               	/* the error count is updated */
 148 005e 4ED6      		jmp	(%a6)		/* return to caller */

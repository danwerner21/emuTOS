  29               	TEST_PATTERN0	=	0x12EDB748 /* X=1 */
  30               	TEST_PATTERN1	=	0x63C1C783 /* X=1 */
  31               	TEST_PATTERN2	=	0xB38F0F83 /* X=1 */
  32               	TEST_PATTERN3	=	0x0635F570 /* X=1 */
  33               	PATTERN_SRAM	=	0x81020410 /* X=0 */

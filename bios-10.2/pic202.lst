  22               	/*	*/
  23               	/*   Register definitions for the NS32202 interrupt controller	*/
  24               	/*	*/
  25               	/*	*/
  26               	.ifndef _ns202def_
  27               	_ns202def_ 	=	1
  28               	.include  "mfpic.s"
  29               	############################################################
  30               	
  31               	
  32               	hvct	        =  0	     /*b	  hardware vector - read by INTA only	*/
  33               	svct	        =  1	     /*b	  software vector - pending	*/
  34               	svcti           =  svct+32   /*b   software vector - in service	*/
  35               	eltg	        =  2	     /*w	  edge/level triggering	*/
  36               	tpl	        =  4	     /*w	  triggering polarity	*/
  37               	ipnd	        =  6	     /*w	  interrupts pending	*/
  38               	isrv	        =  8	     /*w	  interrupts in service	*/
  39               	imsk	        = 10	     /*w	  interrupt mask	*/
  40               	csrc	        = 12	     /*w	  cascaded source	*/
  41               	fprt	        = 14	     /*w	  first priority	*/
  42               	mctl	        = 16	     /*b	  mode control	*/
  43               	ocasn	        = 17	     /*b	  output clock assignment	*/
  44               	ciptr	        = 18	     /*b	  counter interrupt pointer	*/
  45               	pdat	        = 19	     /*b	  port data	*/
68K GAS  pic202.s 			page 3


  46               	ips	        = 20	     /*b	  interrupt/port select	*/
  47               	pdir	        = 21	     /*b	  port direction	*/
  48               	cctl	        = 22	     /*b	  counter control	*/
  49               	cictl	        = 23	     /*b	  counter interrupt control	*/
  50               	lcsv	        = 24	     /*w	  l-counter starting value	*/
  51               	hcsv	        = 26	     /*w	  h-counter starting value	*/
  52               	lccv	        = 28	     /*w	  l-counter current value	*/
  53               	hccv	        = 30	     /*w	  h-counter current value	*/
  54               	
  55               	eoi             = hvct+32    /*b   read for End Of Interrupt signal	*/
  56               	
  57               	
  58               	counter_clock	=	1843200    /* input counter (no prescaling yet) */
  59               	hi_byte	=	25			/* special values needed here */
  60               	
  61               	
  62               	/*    xwxwxwxwbbbbbbbbxwxwxwxwxwxwxwbb	*/
  63               	/*    01010101000000000101010101010100	*/
  64               	
  65               	/*    0101 0101 0000 0000 0101 0101 0101 0100	*/
  66               	/*    0x55005554	*/
  67               	/*    0xFFFC,0xFF00	*/
  68               	
  69               	.endif
  70               	
  27               	############################################################
  28               	
  29               	
  30               		.bss
  31               		.comm	julian_day,4
  32               		.comm	timer_ticks,4
  33               		.comm	timeout,2		/* hi-byte only is used */
  34               	
  35               		.text
  36               	
  37               		.globl	interrupt_3_timer
  38               	interrupt_3_timer:
  39 0000 2F00      		move.l	%d0,-(%sp)	/* save at least D0 */
  40 0002 5279 0000 		add.w	#1,timer_ticks+2	/* increment low word */
  40      0000 
  41 0008 641C      		bcc.s	timeout_check
  42               	
  43 000a 3039 0000 		move.w	timer_ticks,%d0	/* get low count + rollover flag */
  43      0000 
  44 0010 5240      		add.w	#1,%d0		/* increment the low count byte */
  45 0012 0C40 0019 		cmp.w	#hi_byte,%d0
  46 0016 6508      		bcs.s	no_zap
  47               	
  48 0018 52B9 0000 		add.l	#1,julian_day	/* increment the day counter */
  48      0000 
  49 001e 4280      		clr.l	%d0		/* reset the tick counter to midnight */
  50               	no_zap:
  51 0020 33C0 0000 		move.w	%d0,timer_ticks
  51      0000 
  52               	#	br.s	end_of_interrupt
  53               	
  54               	timeout_check:
68K GAS  pic202.s 			page 4


  55 0026 1039 0000 		move.b	timeout,%d0		/* move & test for zero */
  55      0000 
  56 002c 671C      		beq.s	end_of_interrupt
  57 002e 5300      		sub.b	#1,%d0
  58 0030 13C0 0000 		move.b	%d0,timeout		/* decrement it */
  58      0000 
  59 0036 6612      		bne.s	end_of_interrupt
  60               	
  61 0038 48E7 40C0 		movm.l	%d1/%a0/%a1,-(%sp)
  62 003c 4EB9 0000 		jsr	floppy_timeout		/* may be written in C */
  62      0000 
  63 0042 4CDF 0302 		movm.l	(%sp)+,%d1/%a0/%a1
  64               	
  65 0046 6002      		br.s	end_of_interrupt
  66               		
  67               	
  68               		.globl	spurious_return
  69               		.globl	end_of_interrupt
  70               	/*   */
  71               	/*    Return from a spurious interrupt */
  72               	/*   */
  73               	spurious_return:
  74 0048 2F00      		move.l	%d0,-(%sp)		/* stack a scratch register */
  75               	
  76               	/*   fall into the EOI sequence */
  77               	/*   */
  78               	end_of_interrupt:
  79 004a 1038 A040 		move.b	(mf_202 + eoi*256),%d0
  80 004e 201F      		move.l	(%sp)+,%d0		/* restore final register */
  81 0050 4E73      		rte			/* return from exception */
  82               	
  83               	
  84               	/**********************************************************************
  85               	
  86               	 Delay in microseconds:
  87               	
  88               	    Enter with:
  89               		D0 = delay in microseconds (resolution is 16 usec)
  90               	
  91               	**********************************************************************/
  92               		.globl	usec_delay
  93               	usec_delay:
  94 0052 2F01      		move.l	%d1,-(%sp)	/* save D1 */
  95 0054 E848      		lsr	#4,%d0		/* divide by 16 */
  96 0056 2200      		move.l	%d0,%d1		/* D0.w is the low count */
  97 0058 4841      		swap	%d1		/* D1.w is high count, likely 0 */
  98               	ud1:
  99 005a 4EBA 001C 		jsr	usec1x		/* 16 microsecond delay */
 100 005e 51C8 FFFA 		dbra.w	%d0,ud1		/* count down to -1 */
 101 0062 51C9 FFF6 		dbra.w	%d1,ud1		/* count down to -1 */
 102               	
 103 0066 221F      		move.l	(%sp)+,%d1	/* restore D1 */
 104 0068 4E75      		rts
 105               	
 106               	
 107               	# delay XX usec (microseconds)
 108               	# on M68008 @ 8mhz 
68K GAS  pic202.s 			page 5


 109               	#	JSR	().l	= 5 usec
 110               	#	RTS		= 4 usec
 111               	#	NOP		= 1 usec
 112               		.globl	usec20
 113               		.globl	usec16
 114               		.globl	usec12
 115               		.globl	usec10
 116               		.globl	usec09
 117               	usec20:
 118 006a 4E71      		nop
 119 006c 4E71      		nop
 120 006e 4E71      		nop
 121 0070 4E71      		nop
 122               	usec16:
 123 0072 4E71      		nop
 124 0074 4E71      		nop
 125 0076 4E71      		nop
 126               	usec1x:			/* positioned for 'usec_delay' above */
 127 0078 4E71      		nop
 128               	usec12:
 129 007a 4E71      		nop
 130 007c 4E71      		nop
 131               	usec10:
 132 007e 4E71      		nop
 133               	usec09:
 134 0080 4E75      		rts
 135               	
 136               	
 137               	/*
 138               	#--------------------------------------------------------------------------
 139               	#  bios_daytime
 140               	#--------------------------------------------------------------------------
 141               	#  date & time BIOS call
 142               	#
 143               	#    Call with:
 144               	#	D0 = 20	  function code
 145               	#	D1 = return format option:
 146               	#		0 = Julian day, tick count since midnight (binary)
 147               	#		1 = Days since Dec. 31, 1900 (i.e., Jan. 1, 1901 = 1)
 148               	#		    Time in binary seconds since midnight
 149               	#		2 = Binary date:  Word:4:8:4  =  Year:Month(4):Day(8):DayOfWeek(4)  Year=2011, e.g.
 150               	#		    Binary time:  Byte:Byte:Byte:Byte = 0:Hour:Minute:Second (24-hr format)
 151               	#		3 = BCD date:  Byte:Byte:Byte:Byte = Century:Year:Month:Day
 152               	#		    BCD time:  Byte:Byte:Byte:Byte = 00:hh:mm:ss
 153               	#
 154               	#    Return with:
 155               	#	D0 = 	date, per format option
 156               	#	D1 =	time, per format option
 157               	#
 158               	#  There is no error return.
 159               	#
 160               	#--------------------------------------------------------------------------
 161               	*/
 162               			.globl	bios_daytime
 163               	bios_daytime:
 164 0082 4A01      		tst.b	%d1
 165 0084 6610      		bne.s	option1
68K GAS  pic202.s 			page 6


 166 0086 2039 0000 		move.l	julian_day,%d0
 166      0000 
 167 008c 2239 0000 		move.l	timer_ticks,%d1
 167      0000 
 168 0092 6000 0000 		bra	bios_good_return
 169               	
 170               	option1:
 171 0096 2F01      		move.l	%d1,-(%sp)
 172 0098 4EB9 0000 		jsr	daytime_c
 172      0000 
 173 009e 588F      		add.l	#4,%sp
 174 00a0 6000 0000 		bra	bios_good_return

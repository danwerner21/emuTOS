 201               	#-----------------------------------------------------------------------------
 202               	#  ppide_write
 203               	# -----------------------------------------------------------------------------	
 204               	#	;write a sector, specified by the 4 bytes in "lba",
 205               	#	;Return, acc is zero on success, non-zero for an error
 206               	#
 207               	#	arg1	disk number  (D1)
 208               	#	arg2	buffer	(A0)
 209               	#	A1	disk table pointer
 210               	#	D2	LBA address
 211               	#	D3	sector count (assumed to be 1)
 212               	#	A5	principal M68k I/O address of device
 213               	#
 214               	#
 215               	#-----------------------------------------------------------------------------
 216               			.globl	ppide_write
 217               	ppide_write:
 218 00e4 206F 0008 		move.l	(buffer,%sp),%a0		/* get buffer address */
 219 00e8 7005      		move.l	#5,%d0				/* error code */
 220 00ea B4A9 0004 		cmp.l	(disk_lba_o,%a1),%d2		/* check lba address */
 221 00ee 64BE      		bcc.s	read_error
 222               	
 223 00f0 7004      		move.l	#4,%d0				/* error code */
 224 00f2 0C83 0000 		cmp.l	#1,%d3
 224      0001 
 225 00f8 66B4      		bne.s	read_error			/* for now */
 226               	
 227 00fa 6100 00EC 		bsr	ide_wait_not_busy	/* make sure drive is ready */
 228 00fe 66AE      		bne.s	read_error			/* %D0 == -1 */
 229               	
 230 0100 6100 0174 		bsr	wr_lba			/* select device */
 231               	
 232 0104 103C 000F 		move.b	#ide_command,%d0
 233 0108 323C 0030 		move.w	#ide_cmd_write,%d1
 234 010c 6100 01CA 		bsr	ide_write
 235               	
 236 0110 6100 00FA 		bsr	ide_wait_drq		/* wait until it's got the data */
 237 0114 6600 FF98 		bne	error_return
 238               	
 239 0118 6100 0140 		bsr	write_data		/* put the data */
 240               	
 241 011c 6000 FF66 		bra	get_error_status
 242               	

  27               	
  28               	# offsets from the base port address
  29               	portA_o		=	0
  30               	portB_o		=	1
  31               	portC_o		=	2
  32               	portCTRL_o	=	3
  33               	
  34               	# absolute port addresses
  35               	portA		=	mf_ppi + portA_o
  36               	portB		=	mf_ppi + portB_o
  37               	portC		=	mf_ppi + portC_o
  38               	portCTRL	=	mf_ppi + portCTRL_o

  39               	#	
  40               	#------------------------------------------------------------------------------------		
  41               	# Parallel port IDE driver
  42               	#	
  43               	#
  44               	#	
  45               	
  46               	
  47               	
  48               		.even
  49               	# -----------------------------------------------------------------------------	
  50               	#  ppide_read_id
  51               	#  ppide_info		; equivalent
  52               	# -----------------------------------------------------------------------------	
  53               	# Read the 512 byte ID information from the attached drive
  54               	#
  55               	#	arg1	disk number  (D1)
  56               	#	arg2	buffer or NULL	(A0)
  57               	#	A1	disk table pointer
  58               	#	A5	principal M68k I/O address of device
  59               	#
  60               	#-----------------------------------------------------------------------------
  61               			.globl	ppide_info
  62               	ppide_read_id:
  63               	ppide_info:
  64 0000 206F 0008 		move.l	(buffer,%sp),%a0		/* get buffer address */
  65               	
  66 0004 3008      		move	%a0,%d0				/* test for NULL */
  67 0006 4A80      		tst.l	%d0
  68 0008 6734      		beq.s	short_info			/* LBA & GEOM info only */
  69               	
  70 000a 6100 01DC 		bsr	ide_wait_not_busy	/* make sure drive is ready */
  71 000e 6600 009E 		bne	error_return
  72               	
  73 0012 1229 000A 		move.b	(disk_slave_o,%a1),%d1	/* get slave byte */
  74 0016 0201 0010 		and.b	#0x10,%d1		/* for safety */
  75 001a 0001 00E0 		or.b	#0xE0,%d1		/* select LBA mode */
  76 001e 103C 000E 		move.b	#ide_head,%d0		/* write to head register */
  77 0022 6100 02B4 		bsr	ide_write
  78               	
  79 0026 103C 000F 		move.b	#ide_command,%d0
  80 002a 323C 00EC 		move.w	#ide_cmd_id,%d1
  81 002e 6100 02A8 		bsr	ide_write		/* ask the drive to read the ID */
  82               	
  83 0032 6100 01D8 		bsr	ide_wait_drq		/* wait until it's got the data */
  84 0036 6600 0076 		bne	error_return
  85               	
  86 003a 6100 01F4 		bsr	read_data		/* get the data */
  87               	
  88               	short_info:
68K GAS  ppide.s 			page 6


  89 003e 2429 0004 		move.l	disk_lba_o(%a1),%d2		/* LBA info return */
  90 0042 2F42 0004 		move.l	%d2,arg1(%sp)
  91 0046 2429 000C 		move.l	disk_geom_o(%a1),%d2		/* geometry return */
  92               	
  93 004a 6000 0038 		bra	get_error_status
  94               	
  95               	
  96               	
  97               	# -----------------------------------------------------------------------------	
  98               	#  ppide_read
  99               	# -----------------------------------------------------------------------------	
 100               	#	;read a sector, specified by the 4 bytes in "lba",
 101               	#	;Return, acc is zero on success, non-zero for an error
 102               	#
 103               	#	arg1	disk number  (D1)
 104               	#	arg2	buffer	(A0)
 105               	#	A1	disk table pointer
 106               	#	D2	LBA address
 107               	#	D3	sector count (assumed to be 1)
 108               	#	A5	principal M68k I/O address of device
 109               	#
 110               	#
 111               	#-----------------------------------------------------------------------------
 112               			.globl	ppide_read
 113               	ppide_read:
 114 004e 206F 0008 		move.l	(buffer,%sp),%a0		/* get buffer address */
 115 0052 7005      		move.l	#5,%d0				/* error code */
 116 0054 B4A9 0004 		cmp.l	(disk_lba_o,%a1),%d2		/* check lba address */
 117 0058 6454      		bcc.s	read_error
 118               	
 119 005a 7004      		move.l	#4,%d0				/* error code */
 120 005c 0C83 0000 		cmp.l	#1,%d3
 120      0001 
 121 0062 664A      		bne.s	read_error			/* for now */
 122               	
 123 0064 6100 0182 		bsr	ide_wait_not_busy	/* make sure drive is ready */
 124 0068 6644      		bne.s	read_error			/* %D0 == -1 */
 125               	
 126 006a 6100 020A 		bsr	wr_lba			/* select device */
 127               	
 128 006e 103C 000F 		move.b	#ide_command,%d0
 129 0072 323C 0020 		move.w	#ide_cmd_read,%d1
 130 0076 6100 0260 		bsr	ide_write
 131               		
 132 007a 6100 0190 		bsr	ide_wait_drq		/* wait until it's got the data */
 133 007e 662E      		bne.s	read_error			/* %D0 == -1 */
 134               	
 135 0080 6100 01AE 		bsr	read_data		/* get the data */
 136               	
 137               	get_error_status:
 138 0084 6100 0162 		bsr	ide_wait_not_busy	/* make sure drive is ready */
 139 0088 6624      		bne.s	read_error			/* %D0 == -1 */
 140               	
 141 008a 103C 000F 		move.b	#ide_status,%d0
 142 008e 6100 0220 		bsr	ide_read
 143               	
 144 0092 0281 0000 		and.l	#1,%d1			/* check error bit */
68K GAS  ppide.s 			page 7


 144      0001 
 145 0098 6712      		beq.s	exg_return
 146               		
 147 009a 103C 0009 		move.b	#ide_err,%d0
 148 009e 6100 0210 		bsr	ide_read
 149               	
 150 00a2 0281 0000 		and.l	#0xFF,%d1		/* mask to byte */
 150      00FF 
 151 00a8 0041 0800 		or.w	#0x800,%d1
 152               	
 153               	exg_return:
 154 00ac C340      		exg	%d1,%d0
 155               	error_return:
 156               	read_error:
 157 00ae 4E75      		rts
 158               	
 159               	good_return:
 160 00b0 4280      		clr.l	%d0
 161 00b2 4E75      		rts
 162               	
 163               	
 164               	# -----------------------------------------------------------------------------	
 165               	#  ppide_verify
 166               	# -----------------------------------------------------------------------------	
 167               	#	;read a sector, specified by the 4 bytes in "lba",
 168               	#	;Return, acc is zero on success, non-zero for an error
 169               	#
 170               	#	arg1	disk number  (D1)
 171               	#	A1	disk table pointer
 172               	#	D2	LBA address
 173               	#	D3	sector count (assumed to be 1)
 174               	#	A5	principal M68k I/O address of device
 175               	#
 176               	#
 177               	#-----------------------------------------------------------------------------
 178               		.even
 179               	
 180 00b4 6100 0132 		bsr	ide_wait_not_busy	/* make sure drive is ready */
 181 00b8 6600 FFF4 		bne	error_return
 182               	
 183 00bc 262E 0008 		move.l	8(%a6),%d3		/* logical block number */
 184 00c0 242E 000C 		move.l	12(%a6),%d2		/* master/slave */
 185 00c4 6100 01B0 		bsr	wr_lba			/* select device */
 186               	
 187 00c8 103C 000F 		move.b	#ide_command,%d0
 188 00cc 323C 0020 		move.w	#ide_cmd_read,%d1
 189 00d0 6100 0206 		bsr	ide_write
 190               		
 191 00d4 6100 0136 		bsr	ide_wait_drq		/* wait until it's got the data */
 192 00d8 6600 FFD4 		bne	error_return
 193               	
 194 00dc 6100 016C 		bsr	verify_data		/* get the data */
 195               	
 196 00e0 6000 FFA2 		bra	get_error_status
 197               	
 198               	
 199               	
68K GAS  ppide.s 			page 8



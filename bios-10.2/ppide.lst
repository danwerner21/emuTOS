  28               	# Mini-M68k I/O address base
  29               	BOARD_BASE_IO	=	0xFFFF8000
  30               	
  31               	# board base address:
  32               	mfpic_base      =       BOARD_BASE_IO + mf_pic
  33               	
  34               	mf_sio          =       mfpic_base + 8
  35               	mf_ppi          =       mfpic_base + 4
  36               	mf_rtc          =       mfpic_base + 3
  37               	mf_cfg          =       mfpic_base + 2
  38               	mf_202          =       mfpic_base + 0

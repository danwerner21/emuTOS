 574               	#-------------------------------------------------------------------------------
 575               	
 576               	# Low Level I/O to the drive.  These are the routines that talk
 577               	# directly to the drive, via the 8255 chip.  Normally a main
 578               	# program would not call to these.
 579               	
 580               	# Do a read bus cycle to the drive, using the 8255.
 581               	#
 582               	#  Call With:
 583               	#	D0.b = ide register address
 584               	#
 585               	#  Exit With:
 586               	#	D0.b preserved

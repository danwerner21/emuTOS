 340               	#------------------------------------------------------------------------------
 341               	# IDE INTERNAL SUBROUTINES 
 342               	#------------------------------------------------------------------------------
 343               	
 344               	
 345               	#	
 346               	#----------------------------------------------------------------------------
 347               	#  Get Error code
 348               	#
 349               	#	;when an error occurs, we get bit 0 of A set from a call to ide_drq
 350               	#	;or ide_wait_not_busy (which read the drive's status register).  If
 351               	#	;that error bit is set, we should jump here to read the drive's
 352               	#	;explaination of the error, to be returned to the user.  If for
 353               	#	;some reason the error code is zero (shouldn't happen), we'll
 354               	#	;return 255, so that the main program can always depend on a
 355               	#	;return of zero to indicate success.
 356               	#
 357               	#  Exit with:
 358               	#	D0 contains exact status byte as read
68K GAS  ppide.s 			page 11


 359               	#	D1 destroyed
 360               	#----------------------------------------------------------------------------
 361               	.if 0
 362               	get_err:
 363               		move.b	#ide_err,%d0
 364               		bsr	ide_read
 365               	
 366               		clr.l	%d0
 367               		or.b	%d1,%d0
 368               		bne.s	gerr2
 369               		sub.b	#1,%d0
 370               	gerr2:
 371               		rts
 372               	.endif
 373               	
 374               	

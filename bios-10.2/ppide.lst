 392 01f6 0A00 0040 		eor.b	#0x40,%d0		/* want busy==0, rdy==1 */
 393 01fa 0200 00C0 		and.b	#0xC0,%d0		/* mask off Busy(7) & Drdy(6) */
 394 01fe 57CC FFEC 		dbeq.w	%d4,wnb1		/* loop */
 395 0202 6602      		bne.s	wnb2
 396               	
 397 0204 4280      		clr.l	%d0			/* zero extend D0, set EQ (Z-bit) */
 398               	wnb2:

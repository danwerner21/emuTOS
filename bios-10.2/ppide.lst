 244               	RECAL	=  1
 245               	
 246               	#-----------------------------------------------------------------------------
 247               	#--------ppide_reset-------------------------------------------------------
 248               	#
 249               	#	arg1	disk number  (D1)
 250               	#	A1	disk table pointer
 251               	#	A5	principal M68k I/O address of device
 252               	#
 253               	#   Returns D1 (in stack) mask of devices present (D0 == 0)
 254               	#   Error return if no devices on unit.
 255               	# -----------------------------------------------------------------------------	
68K GAS  ppide.s 			page 9


 256               		.globl	ppide_reset
 257               	ppide_reset:
 258 0120 207C 0000 		move.l	#0,%a0			/* accumulate D1 mask here */
 258      0000 
 259               	
 260 0126 1B7C 0092 		move.b	#rd_ide_8255,portCTRL_o(%a5)	/* bsr set_ppi_rd */
 260      0003 
 261               	##	bsr.s	set_ppi_rd		/* setup for a read cycle */
 262               	
 263 012c 4E71      		nop
 264 012e 4E71      		nop
 265 0130 1B7C 0080 		move.b	#ide_rst_line,portC_o(%a5)	/* assert the RST line on the interface */
 265      0002 
 266               	
 267 0136 203C 0000 		move.l	#10000,%d0		/* half a second */
 267      2710 
 268 013c 4EB9 0000 		jsr	usec_delay		/* wait 10ms */
 268      0000 
 269               	
 270 0142 422D 0002 		clr.b	portC_o(%a5)
 271               	
 272 0146 203C 0000 		move.l	#10000,%d0		/* half a second */
 272      2710 
 273 014c 4EB9 0000 		jsr	usec_delay		/* wait 10ms */
 273      0000 
 274               	
 275 0152 2F02      		move.l	%d2,-(%sp)		/* save D2 */
 276 0154 7404      	        moveq #4, %d2                   /* some drives take a while to reset */
 277               	resetwait:
 278 0156 6100 0090 	        bsr     ide_wait_not_busy
 279 015a 51CA FFFA 	        dbra    %d2, resetwait
 280 015e 241F      		move.l	(%sp)+,%d2		/* restore D2 */
 281               	
 282 0160 103C 000F 		move.b	#ide_status,%d0
 283 0164 6100 014A 		bsr	ide_read		/* read status of drive 0 */
 284 0168 0C01 0050 		cmp.b	#0x50,%d1		/* check exact status bits */
 285 016c 661C      		bne.s	reset1
 286               	
 287               	.if RECAL
 288 016e 0829 0004 		btst	#4,(disk_slave_o,%a1)		/* test SLAVE bit */
 288      000A 
 289 0174 6612      		bne.s	reset10				/* branch if SLAVE */
 290 0176 103C 000F 		move.b	#ide_command,%d0	/* do a recalibrate of drive 0 */
 291 017a 123C 0010 		move.b	#ide_cmd_recal,%d1	/* do a recalibrate of the drive */
 292 017e 6100 0158 		bsr	ide_write
 293               		
 294 0182 6100 0064 		bsr	ide_wait_not_busy
 295 0186 6602      		bne.s	reset1
 296               	reset10:
 297               	.endif
 298 0188 5288      		add.l	#1,%a0				/* mark drive 0 present */

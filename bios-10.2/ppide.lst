 548 0282 0201 000F 		and.b	#0x0F,%d1		/* 28 bit limit */
 549 0286 8200      		or.b	%d0,%d1			/* slave bit to D1 */
 550 0288 0001 00E0 		or.b	#0xE0,%d1		/* select LBA mode */

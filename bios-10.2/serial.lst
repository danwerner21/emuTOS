  22               	.ifndef _mfpic_s
  23               	_mfpic_s 	=	1
  24               	
  25               	# Z80 port address of MF/PIC board (required)
  26               	mf_pic		=	0x40
  27               	
  28               	# Mini-M68k I/O address base
  29               	BOARD_BASE_IO	=	0xFFFF8000
  30               	
  31               	# board base address:
  32               	mfpic_base      =       BOARD_BASE_IO + mf_pic
  33               	
  34               	mf_sio          =       mfpic_base + 8
  35               	mf_ppi          =       mfpic_base + 4
  36               	mf_rtc          =       mfpic_base + 3
  37               	mf_cfg          =       mfpic_base + 2
  38               	mf_202          =       mfpic_base + 0
  39               	
  40               	
  41               	.endif
  42               	
  43               	
  26               	############################################################
  27               	
  28               	
  29               	/* Define the 8250, 16450, 16550, 16C550, 16C750 registers  */
  30               	
  31               	sio_thr         = 0+mf_sio	/* transmitter holding register  */
  32               	sio_rbr		= 0+mf_sio	/* receiver buffer register  */
  33               	sio_ier		= 1+mf_sio	/* interrupt enable register  */
  34               	sio_iir		= 2+mf_sio	/* interrupt ident register (r/only)  */
  35               	sio_lcr		= 3+mf_sio	/* line control register  */
  36               	sio_mcr		= 4+mf_sio	/* modem control register  */
  37               	sio_lsr		= 5+mf_sio	/* line status register  */
  38               	sio_msr		= 6+mf_sio	/* modem status register  */
  39               	sio_scr		= 7+mf_sio	/* scratch register  */
  40               	
  41               	sio_dll		=	sio_rbr	/* divisor latch lsbyte  */
  42               	sio_dlm		=	sio_ier	/* divisor latch msbyte  */
  43               	
  44               	/*  define the ier (interrupt enable bits)  */
  45               	
  46               	sio_ier_erbfi	=	0x01	/* enable received data available interrupt  */
  47               	sio_ier_ethei	=	0x02	/* enable transm holding reg empty interrupt  */
  48               	sio_ier_elsi	=	0x04	/* enable receiver line status interrupt  */
  49               	sio_ier_edssi	=	0x08	/* enable modem (data set) status interrupt  */
68K GAS  serial.s 			page 3


  50               	
  51               	
  52               	/*  define the iir (interrupt ident) bit settings  */
  53               	
  54               	sio_iir_none	=	0x01	/* no interrupt is pending  */
  55               	sio_iir_rls 	=	0x06	/* receiver line status int. (highest priority)  */
  56               	sio_iir_rda    	=	0x04	/* received data available  */
  57               	sio_iir_thre	=	0x02	/* transmitter holding register empty  */
  58               	sio_iir_dss	=	0x00	/* modem (data set) status  */
  59               	
  60               	sio_iir_none_bn	=	0x00	/* bit zero is no-int-pending bit  */
  61               	
  62               	
  63               	/*  define the lcr (line control register) bit settings  */
  64               	
  65               	sio_lcr_5bits	=	0x00	/* select 5 data bits  */
  66               	sio_lcr_6bits	=	0x01	/* select 6 data bits  */
  67               	sio_lcr_7bits	=	0x02	/* select 7 data bits  */
  68               	sio_lcr_8bits	=	0x03	/* select 8 data bits  */
  69               	sio_lcr_bit_msk	=	0x03	/* mask for data word length select  */
  70               	sio_lcr_stb2	=	0x04	/* select 2 stop bits  */
  71               	sio_lcr_pen	=	0x08	/* parity enable  */
  72               	sio_lcr_eps	=	0x10	/* even parity select  */
  73               	sio_lcr_stick	=	0x20	/* stick parity  */
  74               	sio_lcr_break	=	0x40	/* set break condition on line  */
  75               	sio_lcr_dlab	=	0x80	/* divisor latch access bit  */
  76               	
  77               	
  78               	/*  define the mcr (modem control register) bits  */
  79               	
  80               	sio_mcr_dtr	=	0x01	/* data terminal ready  */
  81               	sio_mcr_rts	=	0x02	/* request to send  */
  82               	sio_mcr_out1	=	0x04	/* user defined output 1  */
  83               	sio_mcr_out2	=	0x08	/* user defined output 2  */
  84               	sio_mcr_loop	=	0x10	/* diagnostic loopback mode  */
  85               	
  86               	
  87               	/*  define the lsr (line status register) bit settings  */
  88               	
  89               	sio_lsr_dr	=	0x01	/* data ready  */
  90               	sio_lsr_dr_bit	=	0
  91               	sio_lsr_oe	=	0x02	/* overrun error  */
  92               	sio_lsr_oe_bit	=	1
  93               	sio_lsr_pe	=	0x04	/* parity error  */
  94               	sio_lsr_pe_bit	=	2
  95               	sio_lsr_fe	=	0x08	/* framing error  */
  96               	sio_lsr_fe_bit	=	3
  97               	sio_lsr_bi	=	0x10	/* break interrupt  */
  98               	sio_lsr_bi_bit	=	4
  99               	sio_lsr_thre	=	0x20	/* transmitter holding register empty  */
 100               	sio_lsr_thre_bit	=	5
 101               	sio_lsr_temt	=	0x40	/* transmitter empty  */
 102               	sio_lsr_temt_bit	=	6
 103               	
 104               	
 105               	/*  define the msr (modem status register) bit settings  */
 106               	
68K GAS  serial.s 			page 4


 107               	sio_msr_dcts	=	0x01	/* delta clear to send  */
 108               	sio_msr_ddsr	=	0x02	/* delta data set ready  */
 109               	sio_msr_teri	=	0x04	/* trailing edge ring indicator  */
 110               	sio_msr_ddcd	=	0x08	/* delta data carrier detect  */
 111               	sio_msr_cts	=	0x10	/* clear to send  */
 112               	sio_msr_dsr	=	0x20	/* data set ready  */
 113               	sio_msr_ri	=	0x40	/* ring indicator  */
 114               	sio_msr_dcd	=	0x80	/* data carrier detect  */
 115               	
 116               	
 117               	.endif

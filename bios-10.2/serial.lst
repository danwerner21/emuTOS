  22               	#
  23               	#	Definitions of the  Baby M68000 CPU  BIOS trap calls
  24               	#
  25               	#
  26               	bios		=	8		/* trap #8 used for all BIOS calls */
  27               	BIOS		=	8		/* make case insensitive */
  28               	
  29               	
  30               	#  General usage:
  31               	#
  32               	#	move.l	param1,%d1
  33               	#	move.l	param2,%d2
  34               	#	move	address,%a0
  35               	#
  36               	#	move.b	#<bioscall>,%d0		/* BIOS call number in low byte of D0 */
  37               	#	trap	#BIOS
  38               	#
  39               	#	Carry Clear means no error		<some calls only>
  40               	#	Carry Set means an error occurred	<some calls only>
  41               	#	Error code usually returned in D0
  42               	#	Returned values in D1,D2,... A0,...	<see call description>
68K GAS  serial.s 			page 5


  43               	#
  44               	#
  45               	#
  46               	#
  47               	#
  48               	#		   D0 function
  49               	#		      code
  50               	#
  51               	sioput		=	2	/* D1 = character to put out */
  52               	siostr		=	3	/* A0 = string ptr, D1 = termination char */
  53               					/* returns D0 = number of chars put out */
  54               	sioget		=	4	/* D1 = returned character (waits) */
  55               	siotst		=	5	/* D0 = 0, no character available  */
  56               					/* D0 = 1..n, number of characters waiting */
  57               	
  58               	cpuhma		=	6	/* OBSOLETE!!! USE fn 8, D1=0; 
  59               					   old:  return HMA in D0 -- 0x00200000 on max. system */
  60               	cpustop		=	7	/* stop execution */
  61               	hma_alloc	=	8	/* allocate D1 bytes of highest memory; return HMA (new) in D0 */
  62               	
  63               	/* IDE disk drivers */		/* D1 = disk # for all of the following:   */
  64               	disk_reset	=	10	/* D1 = disk # -- may reset entire controller */
  65               	disk_info	=	11	/* D1;  A0 = 512 byte buffer for disk ID */
  66               	disk_read	=	12	/* D1;  A0 = buffer; D2 = LBA sector; D3 = sector count */
  67               	disk_write	=	13	/* ditto */
  68               	disk_verify	=	14	/* D1; D2 = LBA sector; D3 = sector count */
  69               	/* Floppies only:   */
  70               	disk_format	=	15	/* D1; A0 = interleave info/track */
  71               	/*
  72               	   Disk numbers are 0,1 for floppies; 2..7 for IDE disks
  73               	 */
  74               	
  75               	day_time	=	20	/* D1 = return option */
  76               	
  77               	
  78               	# biostrap.s -- end of file
  79               	
  80               	
  25               	############################################################
  26               	
  27               		.globl	bios_good_return
  28               		.comm	nvram,32
  29               	
  30               		.text
  31               	
  32               		.even
  33               	
  34               		.globl	sio_init
  35               	sio_init:
  36               	sio_divisor	=	1843200/16 / 9600
  37 0000 4238 8049 		clr.b	sio_ier			/* disable interrupts */
  38 0004 11FC 0080 		move.b	#sio_lcr_dlab,sio_lcr	/* set divisor latch bit */
  38      804B 
  39 000a 1039 0000 		move.b	nvram+1,%d0		/* MSbyte of divisor */
  39      0000 
  40               	
  41 0010 11F9 0000 		move.b	nvram,sio_dll		/* LSbyte divisor, 9600 bps */
68K GAS  serial.s 			page 6


  41      0000 8048 
  42 0018 11F9 0000 		move.b	nvram+1,sio_dlm		/* MSbyte divisor */
  42      0000 8049 
  43               	sio_continue:
  44 0020 11FC 0003 		move.b	#sio_lcr_8bits,sio_lcr			/* 8n1 */
  44      804B 
  45               	/***	move.b	#sio_lcr_8bits+sio_lcr_stb2,sio_lcr	/* 8n2 */
  46               	
  47               	/* set TERMINAL (MODEM) signals depending on MF/PIC jumpers
  48               			DTR (DSR), RTS (CTS), out1 (CD)	*/
  49 0026 11FC 0007 		move.b	#sio_mcr_dtr+sio_mcr_rts+sio_mcr_out1,sio_mcr
  49      804C 
  50               	
  51               	/*	move.b	#sio_ier_erbfi,sio_ier		/* enable RBF interrupt */
  52               	
  53 002c 4E75      		rts
  54               	
  55               		.globl	_con_out
  56               	/*  C-callable entry */
  57               	_con_out:
  58 002e 102F 0007 		move.b	4+3(%sp),%d0
  59 0032 6008      		br.s	sio_put
  60               		
  61               	/* bios call entry point */
  62               		.globl	bios_sioput
  63               	bios_sioput:
  64 0034 1001      		move.b	%d1,%d0
  65 0036 4879 0000 		pea	bios_good_return
  65      0000 
  66               	#	br.s	sio_put
  67               	/* character put routine */
  68               		.globl	sio_put
  69               	sio_put:
  70 003c 0838 0005 		btst	#sio_lsr_thre_bit,sio_lsr  	/* test THRE */
  70      804D 
  71 0042 6608      		bne.s	sio_putit
  72               	
  73 0044 2F00      		move.l	%d0,-(%sp)
  74 0046 C1C0      		muls	%d0,%d0
  75 0048 201F      		move.l	(%sp)+,%d0
  76 004a 60F0      		br.s	sio_put
  77               	
  78               	sio_putit:
  79 004c 11C0 8048 		move.b	%d0,sio_thr		/* send data byte in D0 */
  80 0050 4E75      		rts
  81               	
  82               			
  83               		.globl	sio_get
  84               	/* get a byte from the serial input, else return -1 */
  85               	sio_get:
  86 0052 70FF      		move.l	#-1,%d0
  87 0054 0838 0000 		btst	#sio_lsr_dr_bit,sio_lsr	  /* test Data Ready */
  87      804D 
  88 005a 6706      		beq.s	sio_gotit		/* return if nothing there */
  89               	
  90 005c 4280      		clr.l	%d0			/* D0 = 0 */
  91 005e 1038 8048 		move.b	sio_rbr,%d0
68K GAS  serial.s 			page 7


  92               	sio_gotit:
  93 0062 4E75      		rts
  94               	
  95               	
  96               	
  97               	
  98               	/* BIOS_sioget -- get a character input when available */
  99               		.globl	bios_sioget
 100               	bios_sioget:
 101 0064 61EC      		bsr.s	sio_get		/* get a character or -1 */
 102 0066 0C80 FFFF 		cmp.l	#-1,%d0		/* check for -1 */
 102      FFFF 
 103 006c 67F6      		beq.s	bios_sioget	/* re-try if -1 */
 104 006e 2200      		move.l	%d0,%d1		/* character returned in D1 */
 105 0070 4280      		clr.l	%d0		/* good return code */
 106 0072 4EF9 0000 		jmp	bios_good_return	/* exit from BIOS call */
 106      0000 
 107               	
 108               	
 109               	
 110               	/* bios_siotst -- return number of charcters waiting */
 111               		.globl	bios_siotst
 112               	bios_siotst:
 113 0078 4280      		clr.l	%d0			  /* say none in buffer */
 114 007a 0838 0000 		btst	#sio_lsr_dr_bit,sio_lsr	  /* test Data Ready */
 114      804D 
 115 0080 6702      		beq.s	siotst_return
 116 0082 5280      		add.l	#1,%d0			/* 1 character is waiting */
 117               	siotst_return:
 118 0084 4EF9 0000 		jmp	bios_good_return	/* exit from BIOS call */
 118      0000 

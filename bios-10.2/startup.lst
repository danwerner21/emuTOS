 892               	.include  "size_ram.s"
   1               	/*  size_ram.s  */
   2               	/*
   3               	    Enter with:
   4               		D7	absolute maximum memory size, 256Mb or 64Mb or 2Mb
   5               	
   6               	    Exit with:
   7               		D0	RAM size
   8               				should be a multiple of 512Kb on the MINI
   9               				or a multiple of 16Mb on the small (x16) KISS
  10               				or a multiple of 64Mb on the large (x64) KISS
  11               	*/
  12               	
  13               	PATTERN	   =	0x12EDB748
  14               	ROTATE	   =	5		/* should be prime */
  15               	TRY	   =	64		/* independent of data cache */
  16               	
  17               	size_ram:
  18 0814 2207      		move.l	%d7,%d1		/* D1 is the increment we'll use */
  19 0816 E889      		lsr.l	#4,%d1		/* increment will be size / 16 */
  20 0818 4280      		clr.l	%d0		/* just in case of total failure */
  21 081a 2241      		move.l	%d1,%a1		/* start testing at first increment */
  22               	sr1:	
  23 081c 6110      		jbsr	test_loc	/* test locations below A1 */
  24 081e 4A82      		tst.l	%d2		/* were there any errors? */
  25 0820 660A      		jbne	sr9		/* jump if errors */
  26 0822 2009      		move.l	%a1,%d0		/* no errors, memory is present */
  27               		
  28 0824 BE80      		cmp.l	%d0,%d7		/* did we test highest possible memory? */
  29 0826 6704      		jbeq	sr9		/* if so, exit */
  30 0828 D3C1      		add.l	%d1,%a1		/* bump to next address to test */
  31 082a 60F0      		jbra	sr1		
  32               	sr9:
  33 082c 4E75      		rts
  34               		
  35               	test_loc:
  36 082e 4282      		clr.l	%d2			/* failure count */
  37               		
  38 0830 263C 12ED 		move.l	#PATTERN,%d3
  38      B748 
  39 0836 2449      		move.l	%a1,%a2
  40 0838 383C 003F 		move.w	#TRY-1,%d4
  41               	tl1:
  42 083c 2503      		move.l	%d3,-(%a2)		/* set a pattern */
  43 083e EA9B      		ror.l	#ROTATE,%d3
  44 0840 51CC FFFA 		dbra	%d4,tl1			/* fill a number of locations */
  45               	
  46               	
  47               	/* now test for memory errors */
  48 0844 263C 12ED 		move.l	#PATTERN,%d3	
  48      B748 
  49 084a 2449      		move.l	%a1,%a2
  50 084c 383C 003F 		move.w	#TRY-1,%d4
  51               	tl2:
68K GAS  startup.s 			page 25


  52 0850 B6A2      		cmp.l	-(%a2),%d3
  53 0852 6702      		jbeq	tl3
  54 0854 5282      		add.l	#1,%d2
  55 0856 EA9B      	tl3:	ror.l	#ROTATE,%d3
  56 0858 51CC FFF6 		dbra	%d4,tl2
  57               		
  58 085c 4E75      		rts
  59               	
  60               	/* end size_ram.s */

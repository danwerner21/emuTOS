  22               	#
  23               	#maxaddr		=	2*1024*1024
  24               	maxchip		=	32*1024
  25               	#maxcount	=	maxaddr/maxchip
  26               	chiplong	=	maxchip/4
  27               	
  28               	/*
  29               	Memory test for the MINI-M68k CPU/memory board
  30               	
  31               	   Enter with:
  32               		A0 is the highest address to test + 1
  33               		A6 is the return address
  34               		D5 is the save of the reset_code
  35               	
  36               	   Returns:
  37               	   	D5 is unchanged
  38               		D6 is the compare failure count (>0 is okay)
  39               		A4 is the lowest address tested (should be 0)
  40               		A5 is the highest address okay + 1
  41               	
  42               	*/
  43               	
  44               		.globl	_memtest
  45               		
  46               	_memtest:
  47               	
  48 07c2 4286      		clr.l	%d6
  49               	
  50 07c4 2408      		move.l	%a0,%d2
  51               	/* assume that maxchip is 32k */
  52 07c6 E08A      		lsr.l	#8,%d2
  53 07c8 EE8A      		lsr.l	#7,%d2		/* D2 >> 15 is count of 32K regions to test */
  54 07ca 5342      		sub.w	#1,%d2
  55               	
  56 07cc 6702      		beq.s	l0
68K GAS  startup.s 			page 23


  57 07ce 5342      		sub.w	#1,%d2
  58               	l0:
  59               	
  60 07d0 2A48      		move.l	%a0,%a5
  61 07d2 283C 12ED 		move.l	#0x12EDB748,%d4
  61      B748 
  62               	
  63               	l1:
  64 07d8 363C 1FFF 		move.w	#chiplong-1,%d3
  65 07dc 2248      		move.l	%a0,%a1
  66               	
  67               	#	move.l	%a1,%d0
  68               	#	bsr	lout
  69               	
  70               	# fill loop
  71               	l12:
  72 07de 2304      		move.l	%d4,-(%a1)
  73 07e0 51CB FFFC 		dbra.w	%d3,l12
  74               	
  75 07e4 363C 1FFF 		move.w	#chiplong-1,%d3
  76 07e8 2248      		move.l	%a0,%a1
  77               	# compare loop
  78               	l13:
  79 07ea B8A1      		cmp.l	-(%a1),%d4
  80               	
  81 07ec 56CB FFFC 		dbne.w	%d3,l13
  82 07f0 6716      		beq.s	l19
  83 07f2 2A49      		move.l	%a1,%a5
  84 07f4 5286      		add.l	#1,%d6
  85               	
  86 07f6 43E9 8004 		lea.l	-maxchip+4(%a1),%a1
  87               	l16:
  88 07fa B899      		cmp.l	(%a1)+,%d4
  89 07fc 56CB FFFC 		dbne.w	%d3,l16
  90 0800 6706      		beq.s	l19
  91 0802 4BE9 FFFC 		lea.l	-4(%a1),%a5
  92 0806 5286      		add.l	#1,%d6
  93               	l19:
  94               	
  95 0808 41E8 8000 		lea.l	-maxchip(%a0),%a0
  96 080c 51CA FFCA 	   	dbra.w	%d2,l1
  97               		
  98 0810 2848      		move.l	%a0,%a4
  99               	/* return A5 = highest address + 1
 100               		  A4 = lowest address tested	*/
 101               	
 102 0812 4ED6      		jmp	(%a6)
 103               	

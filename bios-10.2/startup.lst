  22               	
  23               	
  24               		.text
  25               	
  26               	.if CPU==68030
  27               	
  28               	/*  The LED flashing stuff is below */
  29               	/*  Note:
  30               		Everything is done in registers, hence, no memory
  31               		may be operational yet.
  32               	*/
  33               	
  34               	/*
  35               	   Enter with:
  36               		D5 is the Red LED 'on' time in tenths of a second
68K GAS  startup.s 			page 26


  37               		Instruction Cache enabled
  38               	
  39               	   Returns:
  40               		D5 is trashed
  41               	*/
  42               	
  43               	LED_on:
  44               		move.l	(%sp)+,%a6
  45               	_LED_on:
  46               		mulu.w	#3000,%d5
  47               		jbra	lon0
  48               	lon2:	swap	%d5
  49               	lon1:	reset
  50               	lon0:	dbra.w	%d5,lon1
  51               		swap	%d5
  52               		dbra.w	%d5,lon2
  53               		jmp	(%a6)
  54               		
  55               	
  56               	/*
  57               	   Enter with:
  58               		D5 is the Red LED 'off' time in tenths of a second
  59               		  Instruction Cache enabled
  60               	
  61               	   Returns:
  62               		D5 is trashed
  63               	*/
  64               	
  65               	LED_off:
  66               		move.l	(%sp)+,%a6
  67               	_LED_off:
  68               		mulu.l	#200000,%d5
  69               		jbra	loff0
  70               	loff2:	swap	%d5
  71               	loff1:	nop
  72               	loff0:	dbra.w	%d5,loff1
  73               		swap	%d5
  74               		dbra.w	%d5,loff2
  75               		jmp	(%a6)
  76               		
  77               	
  78               	.endif
  79               	
  80               	.if CPU<68010
  81               	
  82               	/* same for CPU on the Mini */
  83               	/* ***EXCEPT*** the LED colors are reversed */
  84               	
  85               	BL_delay = 22000
  86               	BL_stack = 0x60		/* back in the "reserved" vector area */
  87               	BL_trap  = 9		/* trap 9 is used to return to supervisor state */
  88               	BL_vector = (32+BL_trap)*4	/* trap vector location */
  89               	
  90               	/*
  91               	   Enter with:
  92               		D5 is the Green LED 'on' time in tenths of a second
  93               		A6 is the saved stack pointer
68K GAS  startup.s 			page 27


  94               	
  95               	   Returns:
  96               		D5 is trashed
  97               	*/
  98               	_LED_on:
  99 085e 027C DFFF 		and.w	#~0x2000,%sr		/* enter user mode */
 100               		
 101 0862 CAFC 55F0 		mulu.w	#BL_delay,%d5
 102 0866 6006      		jbra	lon0
 103 0868 4845      	lon2:	swap	%d5
 104 086a 4E71      	lon1:	nop
 105 086c 4E71      		nop
 106 086e 51CD FFFA 	lon0:	dbra.w	%d5,lon1
 107 0872 4845      		swap	%d5
 108 0874 51CD FFF2 		dbra.w	%d5,lon2
 109               		
 110 0878 4E49      		trap	#BL_trap	/* return via trap to supervisor mode */
 111               	
 112               	
 113               	
 114               	/*
 115               	   Enter with:
 116               		D5 is the Green LED 'off' time in tenths of a second
 117               	
 118               	   Returns:
 119               		D5 is trashed
 120               	*/
 121               	
 122               	_LED_off:
 123 087a CAFC 55F0 		mulu.w	#BL_delay,%d5
 124 087e 6006      		jbra	loff0
 125 0880 4845      	loff2:	swap	%d5
 126 0882 4E71      	loff1:	nop
 127 0884 4E71      		nop
 128 0886 51CD FFFA 	loff0:	dbra.w	%d5,loff1
 129 088a 4845      		swap	%d5
 130 088c 51CD FFF2 		dbra.w	%d5,loff2
 131 0890 4ED6      		jmp	(%a6)
 132               	
 133               	.endif
 134               	
 135               	
 136               	/*  Blink
 137               		skip if (switches) bit 5 set
 138               	
 139               	
 140               	   Enter with:
 141               		D0.w	blink count
 142               		A5	return address
 143               	
 144               	   Returns:
 145               		D0 is trashed
 146               		D5 is trashed
 147               		A5 used for calls, hence, trashed
 148               		A6 ditto
 149               	*/
 150               	
68K GAS  startup.s 			page 28


 151               	Blink:
 152 0892 2A5F      		move.l	(%sp)+,%a5
 153               	_Blink:
 154               	#	btst	#5,(switches).w
 155               	#	jbne	blink9			/* skip if switch set */
 156               	
 157 0894 6024      		jbra	blink0
 158               	blink1:
 159 0896 7A03      		move.l	#3,%d5			/* 0.3 sec off */
 160 0898 4DFA 0004 		lea	(bld1,%pc),%a6		/* JSR LED_off */
 161 089c 60DC      		jbra	_LED_off
 162 089e 7A05      	bld1:	move.l	#5,%d5			/* 0.5 sec on */
 163 08a0 4DFA 000E 		lea	(bld2,%pc),%a6
 164               	.if CPU==68030
 165               		jbra	_LED_on
 166               	bld2:
 167               	.else
 168 08a4 21CE 00A4 		move.l	%a6,(BL_vector)
 169 08a8 2C4F      		move.l	%sp,%a6			/* save SSP */
 170 08aa 3E7C 0060 		move.w	#0x60,%sp		/* use reserved traps for 3 word stack */
 171 08ae 60AE      		jbra	_LED_on
 172               	bld2: /* return via trap #9 */
 173 08b0 2E4E      		move.l	%a6,%sp			/* restore stack pointer */
 174               	.endif
 175 08b2 7A03      		move.l	#3,%d5	      		/* 0.3 sec off */
 176 08b4 4DFA 0004 		lea	(bld3,%pc),%a6
 177 08b8 60C0      		jbra	_LED_off
 178               	bld3:
 179               	blink0:
 180 08ba 51C8 FFDA 		dbra.w	%d0,blink1
 181               	blink9:
 182 08be 4ED5      		jmp	(%a5)

  44               	
  45               	/* error stop codes:       */
  46               	ERR_SRAM_DATA_PATH_1	=	7		/* used in 'sram_test.s'  */
  47               	ERR_SRAM_DATA_PATH_2	=	6		/*    ditto		*/
  48               	ERR_SRAM_BIT_TEST	=	5		/* test every bit in SRAM */
  49               	ERR_UART_NOT_FOUND	=	4		/* cannot find MF/PIC UART */
  50               	/* never can find the UART at power-up, but it is there after a Reset  ??? */
  51               	/* explanation:  MSR is unpredictable  */
  52               	

 189               	/*  Access the Debug board  */
 190               	.if !RETAIL
 191               	
 192               	.if 0
 193               		int lites(int val);	/* the 8-bit light value is put out */
 194               		int switches();		/* the 8-bit value in the switches is read */
 195               	.endif

 254               	data_cache_flush:
 255               	    /* WRS: need to read the documentation here -- can we write just a single bit
 256               	       to flush the data cache, or do we need to read and preserve the other bits? */
 257               	.if CPU>=68020
 258               	    movec.l %cacr,%d0
 259               	    or.w    #CACR_CD,%d0    /* clear data cache */
 260               	    movec.l %d0,%cacr
 261               	.endif

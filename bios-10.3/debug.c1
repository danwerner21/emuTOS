void debug68(int option)
{
#define line cmd_buffer
/*	char line[80];	*/
	char ch, *lp, *tp;
	long n, v;
	long dumpbegin = 0x1000;
	int dumpcount = 0x40;
	int dumpformatsave = fmtW, dumpformat;
	int ucount = 4;
	uint32 udot = 0x1000;
	byte skip = 0;

	radix = 16;
	for (;;) {
		if (!skip) {
			print_state(&state);
			dump_memory(2, state.pc, 16);
			udot = state.pc;
#if CPU<=68010
			cprintf("%06lx:  ", udot);
#else
			cprintf("%08lx:  ", udot);
#endif
			pinstr(udot);	/* print instruction */
			cprintf("\n");
		}
		skip = 1;

		cprintf(">>");
		if ( GETLINE(line) ) {
			lp = line;
			unblank(lp);
			ch = *lp++;
			switch (toupper(ch)) {
				case 'B':	/* Breakpoints */
					ch = *lp++;
					switch (toupper(ch)) {
						case 'C':	clear_breaks(lp); break;
						case 'D':	disable_break(lp); break;
						case 'E':	enable_break(lp); break;
						case 'L':	list_breaks(lp); break;
						case 'P':
						case ' ':	create_break(lp); break;
						default:	cmd_error();
					}
					break;
				case 'D':	/* Dump memory */
					ch = *lp++;
					switch (toupper(ch)) {
						case 'B':	dumpformat = 1; break;
						case 'W':	dumpformat = 2; break;
						case 'D':    /* MSDOS debugger carryover */
						case 'L':	dumpformat = 4; break;
						case 'C':	dumpformat = 3; break;
						default:	dumpformat = dumpformatsave;
								--lp;
					}
					unblank(lp);
					if (*lp == '*') { ++lp; unblank(lp); }
					else if (*lp) dumpbegin = strtoul(lp, &lp, 16);
					unblank(lp);
					if (*lp) dumpcount = strtoul(lp, NULL, 16);
					dumpformatsave = dumpformat;
					fmt_dump(dumpformat,dumpbegin,dumpcount);
					dumpbegin += dumpcount;
					skip = 1;
					break;
				case 'G':	/* Go from here */
					execute_go();
					skip = 0;
					break;
				case 'I':
					n = strtoul(lp, NULL, radix);
					if (my_errno) break;
					n &= 0x3FFF;
					v = inp(n);
					cprintf("%02lx\n", v);
					skip = 1;
					break;
				case 'N':	/* set the numeric radix */
					n = strtoul(lp, NULL, 10);
					if (n < 2 || n > 16) {
						cprintf(" %d\n", radix);
					} else radix = n;
					skip = 1;
					break;
				case 'O':	/* output to a byte port */
					n = strtoul(lp, &lp, radix);
					if (my_errno) break;
					n &= 0x3FFF;
					v = strtoul(lp, &lp, radix);
					if (my_errno) break;
					outp(n,v);
					skip = 1;
					break;
				case 'Q':	/* quit debugger */
					return;
				case 'R':	/* display registers */
					skip = 0;
					tp = token(lp, &lp);
					if (tp) {
						skip = 1;
						n = lookup(builtin, tp, &tp, 1);
						if (my_errno) {
							cmd_error();
							break;
						}
						cprintf(n==19 ? "%04lx : " : n<15 ? "%08lx : " : "%06lx : ",
			                                ((long*)&state)[n]); /* state.d[n]) but n may exceed bounds of d */
						v = GETLINE(line);
						if (v) {
							v = strtoul(line, NULL, radix);
							if (!my_errno) {
								if (n==19) state.sr = v;
								else state.d[n] = v;
							}
						}
					}
					break;
				case 'S':	/* step over a call or jump */
					execute_skipover();
					skip = 0;
					break;
				case 'T':	/* trace into */
					n = strtoul(lp, &lp, radix);
					if (n < 1)  n = 1;
					execute_trace(n);
					skip = 0;
					break;
				case 'U':	/* unassemble */
					unblank(lp);
					if (*lp == '*') { ++lp; unblank(lp); }
					else if (*lp) {
						lookup(builtin, lp, &tp, 1);
						if (my_errno) {
							v = strtoul(lp, &tp, 16);
							if (my_errno) {
								cmd_error();
								break;
							}
							udot = v;
						}
						else udot = lookup_value;
						lp = tp;
						unblank(lp);
					}
					if (*lp) ucount = strtoul(lp, NULL, 10);
					udot &= 0xFFFFFFFE;
					if (ucount < 1) ucount = 1;
					if (ucount > 22) ucount = 22;
					n = ucount;
					while (n--) {
#if CPU<=68010
						cprintf("%06lx:  ", udot);
#else
						cprintf("%08lx:  ", udot);
#endif
						udot += pinstr(udot);
						cprintf("\n");
					}
					break;
				default: /* case 'H': case '?': */
					help();
			} /* switch */
		} /* if */
	} /* for(ever) */
}


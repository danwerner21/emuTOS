/* rom-mini.ld */

SECTIONS
{
	. = 0xFFF80000;                 /* ROM */
	.text :	  { *(.text) }
	.rodata : { *(.rodata) }
	.data :   { *(.data) }
	. = 0x00100;                    /* above 64 of 256 vectors */
	.bss : {
		__bss_start = . ;
		*(.bss)	;
		*(COMMON) ;
		__bss_end = .	;
		_end = .	;
	  }
}


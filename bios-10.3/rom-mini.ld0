/* Retrobrew ECB Mini-68K CPU Card */
MEMORY 
{
    ram    : ORIGIN = 0x000100, LENGTH = 2M    /* leave first 0x100 bytes unused */
/*  ecbmem : ORIGIN = 0x200000, LENGTH = 1536K */
    rom    : ORIGIN = 0x380000, LENGTH = 448K
/*  ecbio  : ORIGIN = 0x3F0000, LENGTH = 64K   */
}

INCLUDE "rom-common.ld";
